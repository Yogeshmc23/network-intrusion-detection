# ─── CyberShield IDS — Environment Configuration ─────────────
# Copy this file to .env and adjust values for your environment.

# MongoDB
MONGO_URI=mongodb://mongodb:27017/ids

# Redis
REDIS_URL=redis://redis:6379

# JWT Authentication
# Use long, random values in production, and NEVER reuse JWT_SECRET as
# JWT_REFRESH_SECRET (the backend also enforces a separate `typ` claim).
# Rotating either secret invalidates existing sessions — users simply sign in
# again; no data is lost.
JWT_SECRET=cybershield-dev-secret-change-in-production
JWT_REFRESH_SECRET=cybershield-refresh-secret-change-in-production
# Access tokens live 15 minutes and refresh tokens 7 days
# (backend/src/config/env.ts). The SPA refreshes access tokens automatically.

# ML Microservice
ML_SERVICE_URL=http://ml-service:8000

# Backend
PORT=5000
NODE_ENV=development
# Comma-separated list of browser origins allowed to call the API directly,
# e.g. "https://ids.example.com,https://admin.ids.example.com".
# When the SPA and API share one origin (the bundled nginx setup), set this to
# the SPA's public origin. Requests without an Origin header (same-origin proxy,
# server-to-server) are always allowed. Non-production also allows localhost.
CORS_ORIGIN=http://localhost:3000

# Frontend (build-time)
# Leave VITE_API_URL unset to use the same-origin `/api` proxy (Vite dev server
# or nginx). Only set it when the browser must call the API on a different
# origin — that origin then also has to be listed in CORS_ORIGIN.
# VITE_API_URL=http://localhost:5000/api
VITE_WS_URL=
