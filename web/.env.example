# ─── CyberShield IDS — Environment Configuration ─────────────
# Copy this file to .env and adjust values for your environment.

# MongoDB
MONGO_URI=mongodb://mongodb:27017/ids

# Redis
REDIS_URL=redis://redis:6379

# JWT Authentication
JWT_SECRET=cybershield-dev-secret-change-in-production
JWT_REFRESH_SECRET=cybershield-refresh-secret-change-in-production

# ML Microservice
ML_SERVICE_URL=http://ml-service:8000

# Backend
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Frontend (build-time)
VITE_API_URL=http://localhost:5000/api
VITE_WS_URL=http://localhost:5000
