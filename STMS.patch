+++ b/client/src/api/endpoints.ts
@@ -0,0 +1,100 @@
+/**
+ * Typed API endpoints (AGENTS.md §3 — shapes come from @stms/shared types).
+ * One module per domain; components never call fetch directly.
+ */
+import type {
+  AnalyticsOverview,
+  CalendarResponse,
+  DashboardSummary,
+  DueBucket,
+  Notification,
+  LoginInput,
+  Paginated,
+  PasswordChangeInput,
+  ProfilePatchInput,
+  RegisterInput,
+  Task,
+  TaskCreateInput,
+  TaskSort,
+  TaskUpdateInput,
+  User,
+} from '@stms/shared';
+import { apiFetch } from './client';
+
+/** Minutes east of UTC (inverse of Date#getTimezoneOffset) — server buckets need it. */
+function tzOffsetMin(): number {
+  return -new Date().getTimezoneOffset();
+}
+
+export const authApi = {
+  me: () => apiFetch<{ user: User }>('/auth/me'),
+  login: (input: LoginInput) =>
+    apiFetch<{ user: User }>('/auth/login', { method: 'POST', body: input }),
+  register: (input: RegisterInput) =>
+    apiFetch<{ user: User }>('/auth/register', { method: 'POST', body: input }),
+  logout: () => apiFetch<void>('/auth/logout', { method: 'POST' }),
+  patchProfile: (patch: ProfilePatchInput) =>
+    apiFetch<{ user: User }>('/auth/profile', { method: 'PATCH', body: patch }),
+  changePassword: (input: PasswordChangeInput) =>
+    apiFetch<void>('/auth/password', { method: 'PUT', body: input }),
+};
+
+export interface TaskListQuery {
+  page: number;
+  limit: number;
+  sort: TaskSort;
+  due?: DueBucket;
+  dueFrom?: string;
+  dueTo?: string;
+  q?: string;
+  subject?: string[];
+  priority?: string[];
+  status?: string[];
+  type?: string[];
+}
+
+export const tasksApi = {
+  list: (q: TaskListQuery) =>
+    apiFetch<Paginated<Task>>('/tasks', { query: { ...q, tzOffset: tzOffsetMin() } }),
+  get: (id: number) => apiFetch<{ task: Task }>(`/tasks/${id}`),
+  create: (input: TaskCreateInput) =>
+    apiFetch<{ task: Task }>('/tasks', { method: 'POST', body: input }),
+  update: (id: number, input: TaskUpdateInput) =>
+    apiFetch<{ task: Task }>(`/tasks/${id}`, { method: 'PATCH', body: input }),
+  remove: (id: number) => apiFetch<void>(`/tasks/${id}`, { method: 'DELETE' }),
+  subjects: () => apiFetch<{ subjects: string[] }>('/tasks/meta/subjects'),
+};
+
+export const dashboardApi = {
+  summary: () =>
+    apiFetch<DashboardSummary>('/dashboard/summary', { query: { tzOffset: tzOffsetMin() } }),
+};
+
+export const calendarApi = {
+  /** Tasks with due dates inside [from, to] — one request per visible grid range. */
+  range: (from: Date, to: Date) =>
+    apiFetch<CalendarResponse>('/calendar', {
+      query: { from: from.toISOString(), to: to.toISOString() },
+    }),
+};
+
+export interface NotificationListQuery {
+  page: number;
+  limit: number;
+  unreadOnly?: boolean;
+}
+
+export const notificationsApi = {
+  list: (q: NotificationListQuery) =>
+    apiFetch<Paginated<Notification>>('/notifications', { query: { ...q } }),
+  unreadCount: () => apiFetch<{ count: number }>('/notifications/unread-count'),
+  markRead: (id: number) =>
+    apiFetch<{ notification: Notification }>(`/notifications/${id}/read`, { method: 'POST' }),
+  markAllRead: () => apiFetch<void>('/notifications/read-all', { method: 'POST' }),
+  remove: (id: number) => apiFetch<void>(`/notifications/${id}`, { method: 'DELETE' }),
+};
+
+export const analyticsApi = {
+  overview: (days: 14 | 30) =>
+    apiFetch<AnalyticsOverview>('/analytics/overview', { query: { days } }),
+};
diff --git a/client/src/auth/AuthProvider.tsx b/client/src/auth/AuthProvider.tsx
new file mode 100644
index 0000000..9f4a622
--- /dev/null
+++ b/client/src/auth/AuthProvider.tsx
@@ -0,0 +1,111 @@
+/**
+ * Auth state (ARCHITECTURE.md §4). The ['me'] bootstrap query runs exactly once
+ * on mount; afterward state is owned imperatively:
+ * - login/register set the user directly (no refetch needed)
+ * - logout clears it
+ * - any 401 (event 'stms:unauthorized' from the API client) clears it + flags
+ *   sessionExpired, so ProtectedRoute redirects to /login?next=… with an honest
+ *   "You were signed out" notice (DESIGN.md §7).
+ * A state machine (not a live ['me'] cache) avoids a 401 → invalidate → refetch-401 loop.
+ */
+import { createContext, useContext, useEffect, useMemo, useState, type ReactNode } from 'react';
+import { useQuery } from '@tanstack/react-query';
+import type { LoginInput, RegisterInput, User } from '@stms/shared';
+import { authApi } from '../api/endpoints';
+import { UNAUTHORIZED_EVENT } from '../api/client';
+
+export type AuthStatus = 'loading' | 'authed' | 'anon';
+
+export interface AuthContextValue {
+  user: User | null;
+  status: AuthStatus;
+  /** True when a live session was killed by a 401 (session expiry notice on /login). */
+  sessionExpired: boolean;
+  clearSessionExpired: () => void;
+  login: (input: LoginInput) => Promise<User>;
+  register: (input: RegisterInput) => Promise<User>;
+  logout: () => Promise<void>;
+  setUser: (user: User) => void;
+}
+
+const AuthContext = createContext<AuthContextValue | null>(null);
+
+export function AuthProvider({ children }: { children: ReactNode }) {
+  const [user, setUserState] = useState<User | null>(null);
+  const [bootstrapped, setBootstrapped] = useState(false);
+  const [sessionExpired, setSessionExpired] = useState(false);
+
+  // Bootstrap: is there a valid session cookie? (401 → anon; other errors → anon too,
+  // honest for a login-gated app; user can retry by signing in.)
+  const me = useQuery({
+    queryKey: ['me'],
+    queryFn: authApi.me,
+    enabled: !bootstrapped,
+    retry: false,
+    staleTime: Infinity,
+  });
+  useEffect(() => {
+    if (bootstrapped) return;
+    if (me.isSuccess) {
+      setUserState(me.data.user);
+      setBootstrapped(true);
+    } else if (me.isError) {
+      setUserState(null);
+      setBootstrapped(true);
+    }
+  }, [me.isSuccess, me.isError, me.data, bootstrapped]);
+
+  // Global sign-out signal from the API client (any request returning 401).
+  useEffect(() => {
+    const onUnauthorized = () => {
+      setUserState((prev) => {
+        if (prev !== null) setSessionExpired(true); // only "expired" if we believed we were in
+        return null;
+      });
+      setBootstrapped(true);
+    };
+    window.addEventListener(UNAUTHORIZED_EVENT, onUnauthorized);
+    return () => window.removeEventListener(UNAUTHORIZED_EVENT, onUnauthorized);
+  }, []);
+
+  const status: AuthStatus = bootstrapped ? (user ? 'authed' : 'anon') : 'loading';
+
+  const value = useMemo<AuthContextValue>(
+    () => ({
+      user,
+      status,
+      sessionExpired,
+      clearSessionExpired: () => setSessionExpired(false),
+      setUser: (u: User) => setUserState(u),
+      login: async (input) => {
+        const res = await authApi.login(input);
+        setUserState(res.user);
+        setSessionExpired(false);
+        setBootstrapped(true);
+        return res.user;
+      },
+      register: async (input) => {
+        const res = await authApi.register(input);
+        setUserState(res.user);
+        setBootstrapped(true);
+        return res.user;
+      },
+      logout: async () => {
+        try {
+          await authApi.logout();
+        } finally {
+          setUserState(null);
+        }
+      },
+    }),
+    [user, status, sessionExpired],
+  );
+
+  return <AuthContext.Provider value={value}>{children}</AuthContext.Provider>;
+}
+
+export function useAuth(): AuthContextValue {
+  const ctx = useContext(AuthContext);
+  if (!ctx) throw new Error('useAuth must be used inside <AuthProvider>');
+  return ctx;
+}
