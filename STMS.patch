+import './styles/components.css';
+
+// Server-state cache (ARCHITECTURE.md §3): the only client "state library".
+const queryClient = new QueryClient({
+  defaultOptions: {
+    queries: {
+      staleTime: 30_000,
+      retry: 1,
+      refetchOnWindowFocus: true,
+    },
+  },
+});
