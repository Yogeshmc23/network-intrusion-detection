+/** Config loading rules (ARCHITECTURE.md §7): fail-fast, env semantics. */
+import { describe, expect, it } from 'vitest';
+import { loadConfig } from '../src/config.js';
+
+const base = {
+  NODE_ENV: 'development',
+  SESSION_SECRET: 'x'.repeat(32),
+};
+
+describe('loadConfig', () => {
+  it('applies documented defaults', () => {
+    const config = loadConfig({ ...base });
+    expect(config.PORT).toBe(3000);
+    expect(config.SESSION_TTL_DAYS).toBe(7);
+    expect(config.SESSION_COOKIE_NAME).toBe('stms_sid');
+    expect(config.smtp).toBeNull();
+    expect(config.dbPath).toMatch(/data[\\/]stms\.sqlite$/);
+    expect(config.isProduction).toBe(false);
+  });
+
+  it('treats empty-string env vars as unset', () => {
+    const config = loadConfig({ ...base, DB_PATH: '', SMTP_HOST: '' });
+    expect(config.dbPath).toMatch(/stms\.sqlite$/);
+    expect(config.smtp).toBeNull();
+  });
+
+  it('rejects partial SMTP configuration (all-or-nothing, API.md §3)', () => {
+    expect(() => loadConfig({ ...base, SMTP_HOST: 'smtp.example.com' })).toThrow(
+      /SMTP config is incomplete/,
+    );
+  });
+
+  it('accepts complete SMTP configuration', () => {
+    const config = loadConfig({
+      ...base,
+      SMTP_HOST: 'smtp.example.com',
+      SMTP_PORT: '465',
+      SMTP_USER: 'user',
+      SMTP_PASS: 'pass',
+      EMAIL_FROM: 'STMS <reminders@example.com>',
+    });
+    expect(config.smtp).toEqual({
+      host: 'smtp.example.com',
+      port: 465,
+      user: 'user',
+      pass: 'pass',
+      from: 'STMS <reminders@example.com>',
+    });
+  });
+
+  it('requires a strong SESSION_SECRET in production', () => {
+    expect(() => loadConfig({ NODE_ENV: 'production', SESSION_SECRET: 'short' })).toThrow(
+      /SESSION_SECRET/,
+    );
+    expect(() => loadConfig({ NODE_ENV: 'production' })).toThrow(/SESSION_SECRET/);
+  });
+
+  it('forces secure cookies when SameSite=None (browser requirement)', () => {
+    const config = loadConfig({ ...base, COOKIE_SAMESITE: 'none' });
+    expect(config.cookieSecure).toBe(true);
+    const lax = loadConfig({ ...base, COOKIE_SAMESITE: 'lax' });
+    expect(lax.cookieSecure).toBe(false);
+  });
+
+  it('rejects invalid values', () => {
+    expect(() => loadConfig({ ...base, PORT: 'not-a-number' })).toThrow();
+    expect(() => loadConfig({ ...base, NODE_ENV: 'staging' })).toThrow();
+  });
+});
diff --git a/server/tests/dashboard.test.ts b/server/tests/dashboard.test.ts
new file mode 100644
index 0000000..4b40141
--- /dev/null
+++ b/server/tests/dashboard.test.ts
@@ -0,0 +1,119 @@
+/**
+ * Phase 4: dashboard summary accuracy (IMPLEMENTATION_PLAN completion criteria:
+ * aggregate accuracy against hand-computed fixtures + zero-data rule).
+ * All fixtures are deterministic regardless of when the suite runs: the
+ * "today" task sits between NOW and local midnight; the "far" task sits
+ * EXACTLY at the weekEnd boundary (must be excluded from week, included in later).
+ */
+import { afterAll, beforeAll, describe, expect, it } from 'vitest';
+import request from 'supertest';
+import type { Agent } from 'supertest';
+import { closeTestApp, createTestApp, type TestContext } from './helpers.js';
+import { dueBucketBoundaries } from '../src/util/time.js';
+
+let ctx: TestContext;
+let agent: Agent;
+
+async function make(body: Record<string, unknown>) {
+  return (await agent.post('/api/tasks').send(body).expect(201)).body.task as { id: number };
+}
+
+beforeAll(async () => {
+  ctx = createTestApp({
+    RATE_LIMIT_AUTH_PER_MIN: '100000',
+    RATE_LIMIT_WRITE_PER_MIN: '100000',
+    RATE_LIMIT_READ_PER_MIN: '100000',
+  });
+  agent = request.agent(ctx.app);
+  await agent
+    .post('/api/auth/register')
+    .send({ name: 'Dash', email: 'dash@t.dev', password: 'Password123!' })
+    .expect(201);
+
+  const b = dueBucketBoundaries(Date.now(), 0);
+  const nowMs = Date.parse(b.nowIso);
+  const futureToday = new Date(nowMs + (Date.parse(b.tomorrowStart) - nowMs) / 2).toISOString();
+
+  await make({
+    title: 'A-overdue',
+    subject: 'Math',
+    type: 'exam',
+    priority: 'high',
+    dueAt: '2020-01-01T12:00:00.000Z',
+  }); // overdue
+  await make({ title: 'B-today', subject: 'Math', type: 'assignment', dueAt: futureToday }); // open, today, not overdue
+  await make({
+    title: 'C-done',
+    subject: 'Math',
+    type: 'study',
+    dueAt: '2020-01-02T12:00:00.000Z',
+    status: 'completed',
+  });
+  await make({ title: 'D-far', subject: 'Physics', type: 'project', dueAt: b.weekEnd }); // exactly at weekEnd → 'later', NOT 'week'
+  await make({ title: 'E-none', subject: 'Physics', type: 'study' }); // unscheduled
+});
+afterAll(() => closeTestApp(ctx));
+
+describe('GET /api/dashboard/summary (F5)', () => {
+  it('aggregates match hand-computed fixture', async () => {
+    const res = await agent.get('/api/dashboard/summary?tzOffset=0').expect(200);
+
+    expect(res.body.counts).toEqual({
+      total: 5,
+      pending: 4,
+      inProgress: 0,
+      completed: 1,
+      overdue: 1, // A-overdue only (C-done is past but completed)
+      dueToday: 1, // B-today
+      dueThisWeek: 1, // [todayStart, weekEnd) — D-far sits exactly AT weekEnd → boundary-excluded
+      unscheduled: 1,
+    });
+    expect(res.body.completionRate).toBe(0.2); // 1 completed / 5 total
+
+    // Up next: overdue first, then nearest deadline; completed/unscheduled excluded.
+    const upNext = res.body.upNext as { title: string }[];
+    expect(upNext.map((t) => t.title)).toEqual(['A-overdue', 'B-today', 'D-far']);
+
+    // Workload: open counts per subject — Math 2 open of 3, Physics 2 open of 2;
+    // tie on `open` broken by total desc (Math first).
+    expect(res.body.workloadBySubject).toEqual([
+      { subject: 'Math', open: 2, total: 3 },
+      { subject: 'Physics', open: 2, total: 2 },
+    ]);
+
+    // Recent activity: contains the completion entry; ≤8 items; newest first.
+    const activity = res.body.recentActivity as { id: number; kind: string; at: string }[];
+    expect(activity.length).toBeGreaterThan(0);
+    expect(activity.length).toBeLessThanOrEqual(8);
+    expect(activity.map((a) => a.kind)).toContain('completed');
+    const times = activity.map((a) => Date.parse(a.at));
+    expect(times).toEqual([...times].sort((x, y) => y - x));
+  });
+
+  it('is zero-data safe for a fresh account', async () => {
+    const fresh = request.agent(ctx.app);
+    await fresh
+      .post('/api/auth/register')
+      .send({ name: 'Empty', email: 'empty@t.dev', password: 'Password123!' })
+      .expect(201);
+    const res = await fresh.get('/api/dashboard/summary').expect(200);
+    expect(res.body.counts).toMatchObject({ total: 0, pending: 0, overdue: 0 });
+    expect(res.body.completionRate).toBeNull();
+    expect(res.body.upNext).toEqual([]);
+    expect(res.body.workloadBySubject).toEqual([]);
+  });
+
+  it('scopes everything to the caller', async () => {
+    const other = request.agent(ctx.app);
+    await other
+      .post('/api/auth/register')
+      .send({ name: 'Other', email: 'other@t.dev', password: 'Password123!' })
+      .expect(201);
+    const res = await other.get('/api/dashboard/summary').expect(200);
+    expect(res.body.counts.total).toBe(0);
+  });
+
+  it('requires auth', async () => {
+    await request(ctx.app).get('/api/dashboard/summary').expect(401);
+  });
+});
diff --git a/server/tests/deadlines-calendar.test.ts b/server/tests/deadlines-calendar.test.ts
new file mode 100644
index 0000000..e9a7f00
--- /dev/null
+++ b/server/tests/deadlines-calendar.test.ts
@@ -0,0 +1,187 @@
+/**
+ * Phase 3 suites: due-bucket quick filters on GET /api/tasks and the calendar
+ * range endpoint. Dates are derived from dueBucketBoundaries() so they are
+ * deterministic regardless of when the suite runs.
+ */
+import { afterAll, beforeAll, describe, expect, it } from 'vitest';
+import request from 'supertest';
+import type { Agent } from 'supertest';
+import { closeTestApp, createTestApp, type TestContext } from './helpers.js';
+import { dueBucketBoundaries } from '../src/util/time.js';
+
+let ctx: TestContext;
+let agent: Agent;
+
+const HOUR = 3_600_000;
+
+async function createTask(body: Record<string, unknown>) {
+  const res = await agent.post('/api/tasks').send(body).expect(201);
+  return res.body.task as { id: number; dueAt: string | null };
+}
+
+beforeAll(async () => {
+  ctx = createTestApp({
+    RATE_LIMIT_AUTH_PER_MIN: '100000',
+    RATE_LIMIT_WRITE_PER_MIN: '100000',
+    RATE_LIMIT_READ_PER_MIN: '100000',
+  });
+  agent = request.agent(ctx.app);
+  await agent
+    .post('/api/auth/register')
+    .send({ name: 'Cal', email: 'cal@t.dev', password: 'Password123!' })
+    .expect(201);
+});
+afterAll(() => closeTestApp(ctx));
+
+describe('due buckets (F4)', () => {
+  it('classifies overdue / today / week / later / none', async () => {
+    const b = dueBucketBoundaries(Date.now(), 0);
+    const now = Date.parse(b.nowIso);
+
+    // Fixed-past date: deterministically overdue, and never in today/week/later.
+    const overdue = await createTask({
+      title: 'was-due',
+      subject: 'Math',
+      type: 'exam',
+      dueAt: '2020-01-01T12:00:00.000Z',
+    });
+    // Midpoint between NOW and local midnight: deterministically future AND today.
+    await createTask({
+      title: 'due-today',
+      subject: 'Math',
+      type: 'assignment',
+      dueAt: new Date(now + (Date.parse(b.tomorrowStart) - now) / 2).toISOString(),
+    });
+    await createTask({
+      title: 'later-this-week',
+      subject: 'Math',
+      type: 'project',
+      dueAt: new Date(Date.parse(b.tomorrowStart) + 12 * HOUR).toISOString(),
+    });
+    await createTask({
+      title: 'far-out',
+      subject: 'Math',
+      type: 'study',
+      dueAt: new Date(Date.parse(b.weekEnd) + 12 * HOUR).toISOString(),
+    });
+    await createTask({ title: 'unscheduled', subject: 'Math', type: 'study' });
+
+    const titlesFor = async (due: string) => {
+      const res = await agent.get(`/api/tasks?due=${due}&limit=100`).expect(200);
+      return (res.body.items as { title: string }[]).map((t) => t.title);
+    };
+
+    const overdueT = await titlesFor('overdue');
+    expect(overdueT).toContain('was-due');
+    expect(overdueT).not.toContain('due-today');
+    expect(overdueT).not.toContain('unscheduled');
+
+    const todayT = await titlesFor('today');
+    expect(todayT).toContain('due-today');
+    expect(todayT).not.toContain('far-out');
+    expect(todayT).not.toContain('unscheduled');
+
+    const weekT = await titlesFor('week'); // [today, today+7d)
+    expect(weekT).toEqual(expect.arrayContaining(['due-today', 'later-this-week']));
+    expect(weekT).not.toContain('far-out');
+
+    const laterT = await titlesFor('later');
+    expect(laterT).toContain('far-out');
+    expect(laterT).not.toContain('later-this-week');
+
+    const noneT = await titlesFor('none');
+    expect(noneT).toContain('unscheduled');
+    expect(noneT).not.toContain('was-due');
+
+    // a completed task leaves the OVERDUE bucket (PRD F4)
+    await agent.patch(`/api/tasks/${overdue.id}`).send({ status: 'completed' }).expect(200);
+    expect(await titlesFor('overdue')).not.toContain('was-due');
+  });
+
+  it('filters by explicit dueFrom/dueTo (inclusive)', async () => {
+    await createTask({
+      title: 'r1',
+      subject: 'Math',
+      type: 'study',
+      dueAt: '2027-03-10T12:00:00.000Z',
+    });
+    const res = await agent
+      .get('/api/tasks?dueFrom=2027-03-10T00:00:00.000Z&dueTo=2027-03-10T23:59:59.999Z')
+      .expect(200);
+    const titles = (res.body.items as { title: string }[]).map((t) => t.title);
+    expect(titles).toContain('r1');
+    expect(titles).not.toContain('far-out');
+  });
+
+  it('rejects invalid bucket values', async () => {
+    await agent.get('/api/tasks?due=whenever').expect(400);
+  });
+});
+
+describe('GET /api/calendar (F6)', () => {
+  beforeAll(async () => {
+    // Fixed-world tasks in November 2026.
+    await createTask({
+      title: 'first-light',
+      subject: 'Hist',
+      type: 'exam',
+      dueAt: '2026-11-01T00:00:00.000Z',
+    });
+    await createTask({
+      title: 'last-second',
+      subject: 'Hist',
+      type: 'exam',
+      dueAt: '2026-11-30T23:59:59.500Z',
+    });
+    await createTask({
+      title: 'day-before',
+      subject: 'Hist',
+      type: 'exam',
+      dueAt: '2026-10-31T23:59:59.000Z',
+    });
+    await createTask({
+      title: 'day-after',
+      subject: 'Hist',
+      type: 'exam',
+      dueAt: '2026-12-01T00:00:00.000Z',
+    });
+    const done = await createTask({
+      title: 'done-in-range',
+      subject: 'Hist',
+      type: 'exam',
+      dueAt: '2026-11-15T10:00:00.000Z',
+    });
+    await agent.patch(`/api/tasks/${done.id}`).send({ status: 'completed' }).expect(200);
+  });
+
+  it('returns tasks within [from,to] (date-only = whole days), incl. completed, excl. unscheduled', async () => {
+    const res = await agent.get('/api/calendar?from=2026-11-01&to=2026-11-30').expect(200);
+    const titles = (res.body.tasks as { title: string }[]).map((t) => t.title);
+    expect(titles).toEqual(expect.arrayContaining(['first-light', 'last-second', 'done-in-range']));
+    expect(titles).not.toContain('day-before');
+    expect(titles).not.toContain('day-after');
+    expect(titles).not.toContain('unscheduled');
+    // ordered by due_at asc
+    const dues = (res.body.tasks as { dueAt: string }[]).map((t) => t.dueAt);
+    expect(dues).toEqual([...dues].sort());
+  });
+
+  it('exact ISO instants are honored (day-grid ranges from the client)', async () => {
+    const res = await agent
+      .get('/api/calendar?from=2026-11-15T00:00:00.000Z&to=2026-11-15T23:59:59.999Z')
+      .expect(200);
+    const titles = (res.body.tasks as { title: string }[]).map((t) => t.title);
+    expect(titles).toEqual(['done-in-range']);
+  });
+
+  it('validates the range (API.md)', async () => {
+    await agent.get('/api/calendar?from=2026-11-30&to=2026-11-01').expect(400);
+    await agent.get('/api/calendar?from=2026-01-01&to=2026-12-01').expect(400); // > 92 days
+    await agent.get('/api/calendar?from=garbage&to=2026-11-01').expect(400);
+    await agent.get('/api/calendar').expect(400); // required params
+  });
+
+  it('requires auth', async () => {
+    await request(ctx.app).get('/api/calendar?from=2026-11-01&to=2026-11-02').expect(401);
+  });
+});
diff --git a/server/tests/health.test.ts b/server/tests/health.test.ts
new file mode 100644
index 0000000..7fed79f
--- /dev/null
+++ b/server/tests/health.test.ts
@@ -0,0 +1,87 @@
+/**
+ * Phase 0 verification (IMPLEMENTATION_PLAN.md): health endpoint, JSON 404/400
+ * envelopes, origin guard, security headers — the app-factory contract itself.
+ */
+import { afterAll, beforeAll, describe, expect, it } from 'vitest';
+import request from 'supertest';
+import { closeTestApp, createTestApp, type TestContext } from './helpers.js';
+
+describe('app factory (Phase 0)', () => {
+  let ctx: TestContext;
+
+  beforeAll(() => {
+    ctx = createTestApp();
+  });
+  afterAll(() => closeTestApp(ctx));
+
+  describe('GET /api/health', () => {
+    it('returns ok with a real db check', async () => {
+      const res = await request(ctx.app).get('/api/health').expect(200);
+      expect(res.body).toMatchObject({ status: 'ok', db: 'ok' });
+      expect(typeof res.body.uptime).toBe('number');
+      expect(typeof res.body.version).toBe('string');
+    });
+
+    it('sets no-store cache control and a request id', async () => {
+      const res = await request(ctx.app).get('/api/health').expect(200);
+      expect(res.headers['cache-control']).toBe('no-store');
+      expect(res.headers['x-request-id']).toBeTruthy();
+    });
+  });
+
+  describe('error conventions (API.md §1)', () => {
+    it('returns a JSON 404 envelope for unknown API paths', async () => {
+      const res = await request(ctx.app).get('/api/does-not-exist').expect(404);
+      expect(res.body.error.code).toBe('NOT_FOUND');
+      expect(typeof res.body.error.message).toBe('string');
+    });
+
+    it('returns 400 VALIDATION_ERROR for malformed JSON', async () => {
+      const res = await request(ctx.app)
+        .post('/api/does-not-exist')
+        .set('Content-Type', 'application/json')
+        .send('{"broken"')
+        .expect(400);
+      expect(res.body.error.code).toBe('VALIDATION_ERROR');
+    });
+  });
+
+  describe('origin guard (CSRF posture)', () => {
+    it('rejects unsafe methods with a mismatched Origin', async () => {
+      const res = await request(ctx.app)
+        .post('/api/does-not-exist')
+        .set('Origin', 'https://evil.example')
+        .set('Content-Type', 'application/json')
+        .send('{}')
+        .expect(403);
+      expect(res.body.error.code).toBe('ORIGIN_MISMATCH');
+    });
+
+    it('passes requests whose Origin matches the Host (reaches routing)', async () => {
+      const res = await request(ctx.app)
+        .post('/api/does-not-exist')
+        .set('Host', 'app.example')
+        .set('Origin', 'https://app.example')
+        .set('Content-Type', 'application/json')
+        .send('{}');
+      // Past the guard: unknown route → 404, not 403.
+      expect(res.status).toBe(404);
+    });
+
+    it('allows unsafe methods without an Origin header (non-browser clients)', async () => {
+      const res = await request(ctx.app)
+        .post('/api/does-not-exist')
+        .set('Content-Type', 'application/json')
+        .send('{}');
+      expect(res.status).toBe(404);
+    });
+  });
+
+  describe('security headers', () => {
+    it('hides x-powered-by and sends a CSP', async () => {
+      const res = await request(ctx.app).get('/api/health').expect(200);
+      expect(res.headers['x-powered-by']).toBeUndefined();
+      expect(res.headers['content-security-policy']).toContain("default-src 'self'");
+    });
+  });
+});
