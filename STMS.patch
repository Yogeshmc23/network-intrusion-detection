+/**
+ * Notification routes (API.md §2). Reads are plain; mark-read is idempotent.
+ * Dev-only scan trigger route lives here too but is mounted ONLY outside
+ * production (app.ts) so tests/dev can drive the scheduler deterministically.
+ */
+import { Router, type Request, type Response } from 'express';
+import { idParamSchema, notificationQuerySchema } from '@stms/shared';
+import type { NotificationQuery } from '@stms/shared';
+import type { Db } from '../../db/connection.js';
+import { asyncHandler } from '../../util/asyncHandler.js';
+import { validateParams, validateQuery } from '../../middleware/validate.js';
+import type { RateLimiters } from '../../middleware/rateLimit.js';
+import * as service from './service.js';
+
+export function createNotificationsRouter({
+  db,
+  limiters,
+}: {
+  db: Db;
+  limiters: Pick<RateLimiters, 'readLimiter' | 'writeLimiter'>;
+}): Router {
+  const router = Router();
+
+  router.get(
+    '/',
+    limiters.readLimiter,
+    validateQuery(notificationQuerySchema),
+    asyncHandler(async (req: Request, res: Response) => {
+      const q = res.locals.query as NotificationQuery;
+      const { items, total } = service.list(db, req.userId!, {
+        unreadOnly: q.unreadOnly,
+        page: q.page,
+        limit: q.limit,
+      });
+      res.json({ items, page: q.page, limit: q.limit, total });
+    }),
+  );
+
+  router.get(
+    '/unread-count',
+    limiters.readLimiter,
+    asyncHandler(async (req: Request, res: Response) => {
+      res.json({ count: service.unreadCount(db, req.userId!) });
+    }),
+  );
+
+  router.post(
+    '/read-all',
+    limiters.writeLimiter,
+    asyncHandler(async (req: Request, res: Response) => {
+      service.markAllRead(db, req.userId!);
+      res.status(204).end();
+    }),
+  );
+
+  router.post(
+    '/:id/read',
+    limiters.writeLimiter,
+    validateParams(idParamSchema),
+    asyncHandler(async (req: Request, res: Response) => {
+      const { id } = res.locals.params as { id: number };
+      res.json({ notification: service.markRead(db, req.userId!, id) });
+    }),
+  );
+
+  router.delete(
+    '/:id',
+    limiters.writeLimiter,
+    validateParams(idParamSchema),
+    asyncHandler(async (req: Request, res: Response) => {
+      const { id } = res.locals.params as { id: number };
+      service.remove(db, req.userId!, id);
+      res.status(204).end();
+    }),
+  );
+
+  return router;
+}
diff --git a/server/src/modules/notifications/service.ts b/server/src/modules/notifications/service.ts
new file mode 100644
index 0000000..d90869b
--- /dev/null
+++ b/server/src/modules/notifications/service.ts
@@ -0,0 +1,203 @@
+/**
+ * Reminder scan + notification list/read operations (ARCHITECTURE.md §6).
+ *
+ * The scan is a PURE function of (db, now) so tests drive it deterministically;
+ * the scheduler tick (services/scheduler.ts) calls it once a minute in prod.
+ * Dedup is enforced by the DB unique index (user_id, kind, task_id) via
+ * INSERT OR IGNORE — a restart or an extra tick can never duplicate a reminder.
+ */
+import type { Notification } from '@stms/shared';
+import { REMINDER } from '@stms/shared';
+import type { Db } from '../../db/connection.js';
+import { httpError } from '../../util/httpError.js';
+import { HOUR_MS, relativeLabel, toIso } from '../../util/time.js';
+
+export interface NotificationRow {
+  id: number;
+  user_id: number;
+  task_id: number | null;
+  kind: string;
+  title: string;
+  body: string;
+  read_at: string | null;
+  created_at: string;
+}
+
+export function toNotification(row: NotificationRow): Notification {
+  return {
+    id: row.id,
+    kind: row.kind as Notification['kind'],
+    title: row.title,
+    body: row.body,
+    taskId: row.task_id,
+    readAt: row.read_at,
+    createdAt: row.created_at,
+  };
+}
+
+interface ScanCandidate {
+  task_id: number;
+  user_id: number;
+  title: string;
+  due_at: string;
+  email_reminders_enabled: number;
+  email: string;
+}
+
+/**
+ * Create reminders for OPEN tasks (completed never notified):
+ *  - deadline_soon_24h : due within (now+1h, now+24h]
+ *  - deadline_soon_1h  : due within (now,     now+1h ]
+ *  - overdue           : due <= now (30-day lookback floor bounds inserts)
+ * Windows are mutually exclusive so one tick never double-pings the same task;
+ * across ticks a task may legitimately get both 24h and 1h reminders.
+ * Returns the number of NEW notifications (0 on every no-op tick).
+ */
+export function runReminderScan(db: Db, nowMs: number = Date.now()): number {
+  const nowIso = toIso(nowMs);
+  const plus1h = toIso(nowMs + HOUR_MS);
+  const plus24h = toIso(nowMs + REMINDER.soonHours * HOUR_MS);
+  const floor = toIso(nowMs - 30 * 24 * HOUR_MS);
+
+  const windows = [
+    {
+      kind: 'deadline_soon_24h',
+      lo: plus1h,
+      hi: plus24h,
+      title: (t: string) => `📅 Due within 24 hours: ${t}`,
+    },
+    {
+      kind: 'deadline_soon_1h',
+      lo: nowIso,
+      hi: plus1h,
+      title: (t: string) => `⏰ Due within the hour: ${t}`,
+    },
+    {
+      kind: 'overdue',
+      lo: floor,
+      hi: nowIso,
+      inclusiveLo: true,
+      title: (t: string) => `🔴 Overdue: ${t}`,
+    },
+  ] as const;
+
+  const insertNotification = db.prepare(
+    `INSERT OR IGNORE INTO notifications (user_id, task_id, kind, title, body, created_at)
+     VALUES (?, ?, ?, ?, ?, ?)`,
+  );
+  const insertEmail = db.prepare(
+    `INSERT INTO email_queue (notification_id, user_id, to_email, subject, body_text, created_at)
+     VALUES (?, ?, ?, ?, ?, ?)`,
+  );
+  const selectCandidates = (inclusiveLo: boolean) =>
+    db.prepare(
+      `SELECT t.id AS task_id, t.user_id, t.title, t.due_at,
+              u.email_reminders_enabled, u.email
+       FROM tasks t
+       JOIN users u ON u.id = t.user_id
+       WHERE t.status != 'completed' AND t.due_at IS NOT NULL
+         AND t.due_at ${inclusiveLo ? '>=' : '>'} ? AND t.due_at <= ?`,
+    );
+
+  const scan = db.transaction((): number => {
+    let created = 0;
+    for (const w of windows) {
+      const rows = selectCandidates('inclusiveLo' in w ? w.inclusiveLo : false).all(
+        w.lo,
+        w.hi,
+      ) as ScanCandidate[];
+      for (const r of rows) {
+        const rel = relativeLabel(nowIso, r.due_at);
+        const body =
+          w.kind === 'overdue'
+            ? `“${r.title}” was due ${rel}. Reschedule it or knock it out now.`
+            : `“${r.title}” is due ${rel}. Plan a block of time for it.`;
+        const info = insertNotification.run(
+          r.user_id,
+          r.task_id,
+          w.kind,
+          w.title(r.title),
+          body,
+          nowIso,
+        );
+        if (info.changes === 0) continue; // unique index → exactly-once per (task, kind)
+        created += info.changes;
+        if (r.email_reminders_enabled === 1) {
+          insertEmail.run(
+            Number(info.lastInsertRowid),
+            r.user_id,
+            r.email,
+            w.title(r.title),
+            `${body}\n\n— Student Task Manager`,
+            nowIso,
+          );
+        }
+      }
+    }
+    return created;
+  });
+  return scan();
+}
+
+// ---------- reads / writes ----------
+
+const SELECT_COLS = `id, user_id, task_id, kind, title, body, read_at, created_at`;
+
+export function list(
+  db: Db,
+  userId: number,
+  opts: { unreadOnly?: boolean; page: number; limit: number },
+): { items: Notification[]; total: number } {
+  const where = `WHERE user_id = ? ${opts.unreadOnly ? 'AND read_at IS NULL' : ''}`;
+  const total = (
+    db.prepare(`SELECT COUNT(*) AS n FROM notifications ${where}`).get(userId) as { n: number }
+  ).n;
+  const rows = db
+    .prepare(
+      `SELECT ${SELECT_COLS} FROM notifications ${where}
+       ORDER BY created_at DESC, id DESC LIMIT ? OFFSET ?`,
+    )
+    .all(userId, opts.limit, (opts.page - 1) * opts.limit) as NotificationRow[];
+  return { items: rows.map(toNotification), total };
+}
+
+export function unreadCount(db: Db, userId: number): number {
+  return (
+    db
+      .prepare('SELECT COUNT(*) AS n FROM notifications WHERE user_id = ? AND read_at IS NULL')
+      .get(userId) as { n: number }
+  ).n;
+}
+
+function getOwned(db: Db, userId: number, id: number): NotificationRow {
+  const row = db
+    .prepare(`SELECT ${SELECT_COLS} FROM notifications WHERE id = ? AND user_id = ?`)
+    .get(id, userId) as NotificationRow | undefined;
+  if (!row) throw httpError.notFound('Notification');
+  return row;
+}
+
+export function markRead(db: Db, userId: number, id: number): Notification {
+  getOwned(db, userId, id); // 404 for foreign ids
+  db.prepare(
+    'UPDATE notifications SET read_at = ? WHERE id = ? AND user_id = ? AND read_at IS NULL',
+  ).run(toIso(Date.now()), id, userId); // idempotent
+  return toNotification(getOwned(db, userId, id));
+}
+
+export function markAllRead(db: Db, userId: number): void {
+  db.prepare('UPDATE notifications SET read_at = ? WHERE user_id = ? AND read_at IS NULL').run(
+    toIso(Date.now()),
+    userId,
+  );
+}
+
+export function remove(db: Db, userId: number, id: number): void {
+  getOwned(db, userId, id);
+  db.prepare('DELETE FROM notifications WHERE id = ? AND user_id = ?').run(id, userId);
+}
+
+/** Expired-session pruning rides the same scheduler tick (ARCHITECTURE.md §6). */
+export function pruneExpiredSessions(db: Db): number {
+  return db.prepare('DELETE FROM sessions WHERE expires_at <= ?').run(toIso(Date.now())).changes;
+}
diff --git a/server/src/modules/tasks/repo.ts b/server/src/modules/tasks/repo.ts
new file mode 100644
index 0000000..aaa73fa
--- /dev/null
+++ b/server/src/modules/tasks/repo.ts
@@ -0,0 +1,310 @@
+/**
+ * Tasks repo (AGENTS.md §6). All SQL parameterized; EVERY statement is scoped
+ * by user_id (ownership enforced here, not only in routes). Returns mapped
+ * camelCase Task objects.
+ */
+import type { DueBucket, Task, TaskPriority, TaskSort, TaskStatus, TaskType } from '@stms/shared';
+import type { Db } from '../../db/connection.js';
+import type { DueBucketBoundaries } from '../../util/time.js';
+
+export const SELECT_COLUMNS = `id, user_id, title, description, subject, type, priority, status,
+  due_at, completed_at, created_at, updated_at`;
+
+export interface TaskRow {
+  id: number;
+  user_id: number;
+  title: string;
+  description: string;
+  subject: string;
+  type: TaskType;
+  priority: TaskPriority;
+  status: TaskStatus;
+  due_at: string | null;
+  completed_at: string | null;
+  created_at: string;
+  updated_at: string;
+}
+
+export function toTask(row: TaskRow): Task {
+  return {
+    id: row.id,
+    title: row.title,
+    description: row.description,
+    subject: row.subject,
+    type: row.type,
+    priority: row.priority,
+    status: row.status,
+    dueAt: row.due_at,
+    completedAt: row.completed_at,
+    createdAt: row.created_at,
+    updatedAt: row.updated_at,
+  };
+}
+
+export function insertTask(
+  db: Db,
+  userId: number,
+  t: {
+    title: string;
+    description: string;
+    subject: string;
+    type: TaskType;
+    priority: TaskPriority;
+    status: TaskStatus;
+    dueAt: string | null;
+    completedAt: string | null;
+    now: string;
+  },
+): Task {
+  const info = db
+    .prepare(
+      `INSERT INTO tasks (user_id, title, description, subject, type, priority, status, due_at, completed_at, created_at, updated_at)
+       VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,
+    )
+    .run(
+      userId,
+      t.title,
+      t.description,
+      t.subject,
+      t.type,
+      t.priority,
+      t.status,
+      t.dueAt,
+      t.completedAt,
+      t.now,
+      t.now,
+    );
+  return findTask(db, userId, Number(info.lastInsertRowid))!;
+}
+
+export function findTask(db: Db, userId: number, id: number): Task | undefined {
+  const row = db
+    .prepare(`SELECT ${SELECT_COLUMNS} FROM tasks WHERE id = ? AND user_id = ?`)
+    .get(id, userId) as TaskRow | undefined;
+  return row ? toTask(row) : undefined;
+}
+
+export interface TaskUpdateFields {
+  title?: string;
+  description?: string;
+  subject?: string;
+  type?: TaskType;
+  priority?: TaskPriority;
+  status?: TaskStatus;
+  dueAt?: string | null;
+}
+
+export function updateTask(
+  db: Db,
+  userId: number,
+  id: number,
+  fields: TaskUpdateFields & { completedAt: string | null; now: string },
+): void {
+  const sets: string[] = ['updated_at = ?', 'completed_at = ?'];
+  const params: (string | number | null)[] = [fields.now, fields.completedAt];
+  for (const key of ['title', 'description', 'subject', 'type', 'priority', 'status'] as const) {
+    const value = fields[key];
+    if (value !== undefined) {
+      sets.push(`${key} = ?`); // fixed allowlist — never user-controlled identifiers
+      params.push(value);
+    }
+  }
+  // Presence-by-VALUE, not by key: the service only sets dueAt when the client
+  // sent it (null = clear; undefined = leave unchanged). A `in` check would be
+  // wrong because the property always exists on the constructed object.
+  if (fields.dueAt !== undefined) {
+    sets.push('due_at = ?');
+    params.push(fields.dueAt);
+  }
+  params.push(userId, id);
+  db.prepare(`UPDATE tasks SET ${sets.join(', ')} WHERE user_id = ? AND id = ?`).run(...params);
+}
+
+export function deleteTask(db: Db, userId: number, id: number): void {
+  db.prepare('DELETE FROM tasks WHERE user_id = ? AND id = ?').run(userId, id);
+}
+
+// ---------- listing with sort + due buckets (filters land in Phase 7) ----------
+
+const PRIORITY_CASE = `CASE priority WHEN 'high' THEN 3 WHEN 'medium' THEN 2 ELSE 1 END`;
+
+function orderBy(sort: TaskSort, nowIso: string): { sql: string; params: string[] } {
+  switch (sort) {
+    case 'due_asc':
+      return { sql: 'ORDER BY (due_at IS NULL), due_at ASC, id DESC', params: [] };
+    case 'due_desc':
+      return { sql: 'ORDER BY due_at DESC, id DESC', params: [] };
+    case 'priority_desc':
+      return {
+        sql: `ORDER BY ${PRIORITY_CASE} DESC, (due_at IS NULL), due_at ASC, id DESC`,
+        params: [],
+      };
+    case 'created_desc':
+      return { sql: 'ORDER BY created_at DESC, id DESC', params: [] };
+    case 'title_asc':
+      return { sql: 'ORDER BY title COLLATE NOCASE ASC, id DESC', params: [] };
+    case 'smart':
+    default:
+      // PRD F3: overdue first, then nearest deadline, then priority, then newest.
+      return {
+        sql: `ORDER BY
+          (due_at IS NOT NULL AND status != 'completed' AND due_at < ?) DESC,
+          (due_at IS NULL),
+          due_at ASC,
+          ${PRIORITY_CASE} DESC,
+          created_at DESC,
+          id DESC`,
+        params: [nowIso],
+      };
+  }
+}
+
+/**
+ * WHERE fragments for the due-bucket quick filters (API.md). Buckets are
+ * status-agnostic EXCEPT `overdue`, which by definition excludes completed
+ * work (PRD F4). `week` spans [today, today+7d) and therefore includes today;
+ * chips are filters, not a partition. todayStart/tomorrowStart/weekEnd come
+ * from dueBucketBoundaries() — UTC-day based, or user-local when the client
+ * sends tzOffset.
+ */
+export function dueFilterSql(
+  due: DueBucket | undefined,
+  b: DueBucketBoundaries,
+  dueFrom?: string,
+  dueTo?: string,
+): { sql: string; params: string[] } {
+  const parts: string[] = [];
+  const params: string[] = [];
+  switch (due) {
+    case 'overdue':
+      parts.push("due_at IS NOT NULL AND due_at < ? AND status != 'completed'");
+      params.push(b.nowIso);
+      break;
+    case 'today':
+      parts.push('due_at IS NOT NULL AND due_at >= ? AND due_at < ?');
+      params.push(b.todayStart, b.tomorrowStart);
+      break;
+    case 'week':
+      parts.push('due_at IS NOT NULL AND due_at >= ? AND due_at < ?');
+      params.push(b.todayStart, b.weekEnd);
+      break;
+    case 'later':
+      parts.push('due_at IS NOT NULL AND due_at >= ?');
+      params.push(b.weekEnd);
+      break;
+    case 'none':
+      parts.push('due_at IS NULL');
+      break;
+    default:
+      break;
+  }
+  if (dueFrom) {
+    parts.push('due_at >= ?');
+    params.push(dueFrom);
+  }
+  if (dueTo) {
+    parts.push('due_at <= ?');
+    params.push(dueTo);
+  }
+  return { sql: parts.join(' AND '), params };
+}
+
+/** Full filter set for GET /api/tasks (F9). Multi-values are ORs within a field, AND across fields. */
+export interface TaskFilters {
+  q?: string;
+  subject?: string[];
+  priority?: string[];
+  status?: string[];
+  type?: string[];
+  due?: DueBucket;
+  dueFrom?: string;
+  dueTo?: string;
+}
+
+/** SQLite LIKE escapes; user text must match literally (ASCII case-insensitive via LIKE). */
+function likeEscape(s: string): string {
+  return s.replace(/[\\%_]/g, (m) => `\\${m}`);
+}
+
+export function buildWhere(
+  userId: number,
+  filters: TaskFilters,
+  boundaries: DueBucketBoundaries,
+): { sql: string; params: (string | number)[] } {
+  const parts: string[] = ['user_id = ?'];
+  const params: (string | number)[] = [userId];
+
+  if (filters.q) {
+    parts.push(
+      "(title LIKE ? ESCAPE '\\' OR description LIKE ? ESCAPE '\\' OR subject LIKE ? ESCAPE '\\')",
+    );
+    const p = `%${likeEscape(filters.q)}%`;
+    params.push(p, p, p);
+  }
+  for (const [col, values] of [
+    ['subject', filters.subject],
+    ['priority', filters.priority],
+    ['status', filters.status],
+    ['type', filters.type],
+  ] as const) {
+    if (values && values.length > 0) {
+      parts.push(`${col} IN (${values.map(() => '?').join(', ')})`);
+      params.push(...values);
+    }
+  }
+  const due = dueFilterSql(filters.due, boundaries, filters.dueFrom, filters.dueTo);
+  if (due.sql) {
+    parts.push(due.sql); // internal AND-chain of plain predicates — safe to join at top level
+    params.push(...due.params);
+  }
+  return { sql: `WHERE ${parts.join(' AND ')}`, params };
+}
+
+export function listTasks(
+  db: Db,
+  userId: number,
+  opts: {
+    sort: TaskSort;
+    page: number;
+    limit: number;
+    boundaries: DueBucketBoundaries;
+    filters: TaskFilters;
+  },
+): { items: Task[]; total: number } {
+  const { sql: orderSql, params: orderParams } = orderBy(opts.sort, opts.boundaries.nowIso);
+  const where = buildWhere(userId, opts.filters, opts.boundaries);
+  const total = (
+    db.prepare(`SELECT COUNT(*) AS n FROM tasks ${where.sql}`).get(...where.params) as {
+      n: number;
+    }
+  ).n;
+  const rows = db
+    .prepare(
+      `SELECT ${SELECT_COLUMNS} FROM tasks ${where.sql}
+       ${orderSql}
+       LIMIT ? OFFSET ?`,
+    )
+    .all(...where.params, ...orderParams, opts.limit, (opts.page - 1) * opts.limit) as TaskRow[];
+  return { items: rows.map(toTask), total };
+}
+
+/** Tasks with a due date inside [from, to] (inclusive), for calendar ranges. */
+export function tasksInRange(db: Db, userId: number, fromIso: string, toIso: string): Task[] {
+  const rows = db
+    .prepare(
+      `SELECT ${SELECT_COLUMNS} FROM tasks
+       WHERE user_id = ? AND due_at IS NOT NULL AND due_at >= ? AND due_at <= ?
+       ORDER BY due_at ASC, id ASC`,
+    )
+    .all(userId, fromIso, toIso) as TaskRow[];
+  return rows.map(toTask);
+}
+
+export function distinctSubjects(db: Db, userId: number): string[] {
+  const rows = db
+    .prepare(
+      'SELECT DISTINCT subject FROM tasks WHERE user_id = ? ORDER BY subject COLLATE NOCASE ASC',
+    )
+    .all(userId) as { subject: string }[];
+  return rows.map((r) => r.subject);
+}
diff --git a/server/src/modules/tasks/routes.ts b/server/src/modules/tasks/routes.ts
new file mode 100644
index 0000000..ab535e3
--- /dev/null
+++ b/server/src/modules/tasks/routes.ts
@@ -0,0 +1,99 @@
+/**
+ * Tasks routes (API.md §2 "Tasks"). requireAuth + write/read rate limiters are
+ * applied at mount time in app.ts. Parsed query lives in res.locals.query
+ * (validate.ts) because Express 5 exposes req.query as a getter.
+ */
+import { Router, type Request, type Response } from 'express';
+import { idParamSchema, taskCreateSchema, taskQuerySchema, taskUpdateSchema } from '@stms/shared';
+import type { TaskQuery } from '@stms/shared';
+import type { Db } from '../../db/connection.js';
+import { asyncHandler } from '../../util/asyncHandler.js';
+import { validateBody, validateParams, validateQuery } from '../../middleware/validate.js';
+import type { RateLimiters } from '../../middleware/rateLimit.js';
+import * as service from './service.js';
+
+export interface TasksRouterDeps {
+  db: Db;
+  limiters: Pick<RateLimiters, 'readLimiter' | 'writeLimiter'>;
+}
+
+export function createTasksRouter({ db, limiters }: TasksRouterDeps): Router {
+  const router = Router();
+
+  router.get(
+    '/',
+    limiters.readLimiter,
+    validateQuery(taskQuerySchema),
+    asyncHandler(async (req: Request, res: Response) => {
+      const q = res.locals.query as TaskQuery;
+      const { items, total } = service.list(db, req.userId!, {
+        sort: q.sort,
+        page: q.page,
+        limit: q.limit,
+        q: q.q,
+        subject: q.subject,
+        priority: q.priority,
+        status: q.status,
+        type: q.type,
+        due: q.due,
+        dueFrom: q.dueFrom,
+        dueTo: q.dueTo,
+        tzOffset: q.tzOffset,
+      });
+      res.json({ items, page: q.page, limit: q.limit, total });
+    }),
+  );
+
+  // Static segment BEFORE /:id so 'meta' is never parsed as an id.
+  router.get(
+    '/meta/subjects',
+    limiters.readLimiter,
+    asyncHandler(async (req: Request, res: Response) => {
+      res.json({ subjects: service.subjects(db, req.userId!) });
+    }),
+  );
+
+  router.post(
+    '/',
+    limiters.writeLimiter,
+    validateBody(taskCreateSchema),
+    asyncHandler(async (req: Request, res: Response) => {
+      const task = service.createTask(db, req.userId!, req.body);
+      res.status(201).json({ task });
+    }),
+  );
+
+  router.get(
+    '/:id',
+    limiters.readLimiter,
+    validateParams(idParamSchema),
+    asyncHandler(async (req: Request, res: Response) => {
+      const { id } = res.locals.params as { id: number };
+      res.json({ task: service.getTask(db, req.userId!, id) });
+    }),
+  );
+
+  router.patch(
+    '/:id',
+    limiters.writeLimiter,
+    validateParams(idParamSchema),
+    validateBody(taskUpdateSchema),
+    asyncHandler(async (req: Request, res: Response) => {
+      const { id } = res.locals.params as { id: number };
+      res.json({ task: service.patchTask(db, req.userId!, id, req.body) });
+    }),
+  );
+
+  router.delete(
+    '/:id',
+    limiters.writeLimiter,
+    validateParams(idParamSchema),
+    asyncHandler(async (req: Request, res: Response) => {
+      const { id } = res.locals.params as { id: number };
+      service.removeTask(db, req.userId!, id);
+      res.status(204).end();
+    }),
+  );
+
+  return router;
+}
diff --git a/server/src/modules/tasks/service.ts b/server/src/modules/tasks/service.ts
new file mode 100644
index 0000000..92b2022
--- /dev/null
+++ b/server/src/modules/tasks/service.ts
@@ -0,0 +1,105 @@
+/**
+ * Tasks service: business rules only (no HTTP). Enforces the
+ * status/completed_at invariant in a transaction (DATABASE.md §4) and maps
+ * "not found" to 404 (ownership — never leaks existence).
+ */
+import type { DueBucket, Task, TaskCreateInput, TaskSort, TaskUpdateInput } from '@stms/shared';
+import type { Db } from '../../db/connection.js';
+import { httpError } from '../../util/httpError.js';
+import { dueBucketBoundaries, toIso } from '../../util/time.js';
+import * as repo from './repo.js';
+
+export interface ListParams {
+  sort: TaskSort;
+  page: number;
+  limit: number;
+  q?: string;
+  subject?: string[];
+  priority?: string[];
+  status?: string[];
+  type?: string[];
+  due?: DueBucket;
+  dueFrom?: string;
+  dueTo?: string;
+  /** Minutes east of UTC from the client (default 0 = UTC days). */
+  tzOffset: number;
+}
+
+export function createTask(db: Db, userId: number, input: TaskCreateInput): Task {
+  const now = toIso(Date.now());
+  const status = input.status ?? 'pending';
+  return repo.insertTask(db, userId, {
+    title: input.title,
+    description: input.description ?? '',
+    subject: input.subject,
+    type: input.type,
+    priority: input.priority ?? 'medium',
+    status,
+    dueAt: normalizeDue(input.dueAt),
+    completedAt: status === 'completed' ? now : null,
+    now,
+  });
+}
+
+export function getTask(db: Db, userId: number, id: number): Task {
+  const task = repo.findTask(db, userId, id);
+  if (!task) throw httpError.notFound('Task');
+  return task;
+}
+
+export function patchTask(db: Db, userId: number, id: number, input: TaskUpdateInput): Task {
+  const existing = repo.findTask(db, userId, id);
+  if (!existing) throw httpError.notFound('Task');
+
+  const now = toIso(Date.now());
+  const nextStatus = input.status ?? existing.status;
+  // Invariant: completed_at is set exactly while status === 'completed'.
+  let completedAt: string | null = existing.completedAt;
+  if (nextStatus === 'completed') {
+    completedAt = existing.completedAt ?? now;
+  } else if (input.status !== undefined) {
+    completedAt = null; // reopening
+  }
+
+  const tx = db.transaction(() => {
+    repo.updateTask(db, userId, id, {
+      title: input.title,
+      description: input.description,
+      subject: input.subject,
+      type: input.type,
+      priority: input.priority,
+      status: input.status,
+      dueAt: 'dueAt' in input ? normalizeDue(input.dueAt) : undefined,
+      completedAt,
+      now,
+    });
+    return repo.findTask(db, userId, id)!;
+  });
+  return tx();
+}
+
+export function removeTask(db: Db, userId: number, id: number): void {
+  const existing = repo.findTask(db, userId, id);
+  if (!existing) throw httpError.notFound('Task');
+  repo.deleteTask(db, userId, id); // cascades notifications + email_queue rows
+}
+
+export function list(db: Db, userId: number, params: ListParams): { items: Task[]; total: number } {
+  const { sort, page, limit, tzOffset, ...filters } = params;
+  return repo.listTasks(db, userId, {
+    sort,
+    page,
+    limit,
+    filters,
+    boundaries: dueBucketBoundaries(Date.now(), tzOffset),
+  });
+}
+
+export function subjects(db: Db, userId: number): string[] {
+  return repo.distinctSubjects(db, userId);
+}
+
+function normalizeDue(value: string | null | undefined): string | null {
+  if (value === undefined || value === null) return null;
+  return new Date(value).toISOString(); // stored UTC Z (DATABASE.md preamble)
+}
diff --git a/server/src/services/email.ts b/server/src/services/email.ts
new file mode 100644
index 0000000..f2a4fcb
--- /dev/null
+++ b/server/src/services/email.ts
@@ -0,0 +1,122 @@
+/**
+ * Email queue sender (ARCHITECTURE.md §6). Two modes, no faking:
+ *  - SMTP configured → nodemailer send; failures retry up to REMINDER.maxEmailAttempts,
+ *    then state 'failed' with last_error (surfaced in monitoring, never crashes the app).
+ *  - SMTP NOT configured → queue rows are written as .eml files to the dev OUTBOX
+ *    directory and marked 'skipped_no_smtp'. Files are clearly labeled as dev-only.
+ */
+import fs from 'node:fs';
+import path from 'node:path';
+import nodemailer, { type Transporter } from 'nodemailer';
+import { REMINDER } from '@stms/shared';
+import type { Db } from '../db/connection.js';
+import type { AppConfig } from '../config.js';
+import type { Logger } from '../util/logger.js';
+import { toIso } from '../util/time.js';
+
+interface QueueRow {
+  id: number;
+  to_email: string;
+  subject: string;
+  body_text: string;
+  attempts: number;
+}
+
+let cachedTransport: { key: string; transport: Transporter } | undefined;
+
+function getTransport(config: AppConfig): Transporter | undefined {
+  if (!config.smtp) return undefined;
+  const key = `${config.smtp.host}:${config.smtp.port}:${config.smtp.user}`;
+  if (cachedTransport?.key !== key) {
+    cachedTransport = {
+      key,
+      transport: nodemailer.createTransport({
+        host: config.smtp.host,
+        port: config.smtp.port,
+        secure: config.smtp.port === 465, // 465 = implicit TLS, 587 = STARTTLS upgrade
+        auth: { user: config.smtp.user, pass: config.smtp.pass },
+      }),
+    };
+  }
+  return cachedTransport.transport;
+}
+
+function writeOutbox(dir: string, row: QueueRow): string {
+  fs.mkdirSync(dir, { recursive: true });
+  const file = path.join(dir, `${Date.now()}-${row.id}.eml`);
+  fs.writeFileSync(
+    file,
+    [
+      'X-STMS-Dev-Outbox: SMTP is not configured; this email was NOT sent.',
+      `To: ${row.to_email}`,
+      `Subject: ${row.subject}`,
+      'Content-Type: text/plain; charset=utf-8',
+      '',
+      row.body_text,
+      '',
+    ].join('\r\n'),
+  );
+  return file;
+}
+
+/**
+ * Drain up to `limit` pending queue rows. Returns counts by outcome.
+ * Called by the scheduler tick and by the dev-only scan endpoint.
+ */
+export async function drainEmailQueue(
+  db: Db,
+  config: AppConfig,
+  logger: Logger,
+  limit = 20,
+): Promise<{ sent: number; skipped: number; failed: number; pending: number }> {
+  const transport = getTransport(config);
+  const rows = db
+    .prepare(
+      `SELECT id, to_email, subject, body_text, attempts
+       FROM email_queue WHERE state = 'pending' ORDER BY created_at ASC LIMIT ?`,
+    )
+    .all(limit) as QueueRow[];
+
+  const out = { sent: 0, skipped: 0, failed: 0, pending: 0 };
+  for (const row of rows) {
+    if (!transport) {
+      writeOutbox(config.outboxDir, row);
+      db.prepare("UPDATE email_queue SET state = 'skipped_no_smtp', sent_at = ? WHERE id = ?").run(
+        toIso(Date.now()),
+        row.id,
+      );
+      out.skipped++;
+      continue;
+    }
+    try {
+      await transport.sendMail({
+        from: config.smtp!.from,
+        to: row.to_email,
+        subject: row.subject,
+        text: row.body_text,
+      });
+      db.prepare(
+        "UPDATE email_queue SET state = 'sent', sent_at = ?, last_error = NULL WHERE id = ?",
+      ).run(toIso(Date.now()), row.id);
+      out.sent++;
+    } catch (err) {
+      const attempts = row.attempts + 1;
+      const message = err instanceof Error ? err.message : String(err);
+      if (attempts >= REMINDER.maxEmailAttempts) {
+        db.prepare(
+          "UPDATE email_queue SET state = 'failed', attempts = ?, last_error = ? WHERE id = ?",
+        ).run(attempts, message.slice(0, 500), row.id);
+        out.failed++;
+        logger.error({ queueId: row.id, attempts }, `email permanently failed: ${message}`);
+      } else {
+        db.prepare('UPDATE email_queue SET attempts = ?, last_error = ? WHERE id = ?').run(
+          attempts,
+          message.slice(0, 500),
+          row.id,
+        );
+        out.pending++; // stays 'pending' for retry next tick
+      }
+    }
+  }
+  return out;
+}
