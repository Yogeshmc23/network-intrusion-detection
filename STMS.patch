+.cal-cell-other {
+  background: transparent;
+  border-color: transparent;
+}
+.cal-cell-other .cal-daynum {
+  color: var(--text-muted);
+  opacity: 0.6;
+}
+.cal-cell-today {
+  outline: 2px solid var(--brand);
+  outline-offset: -2px;
+}
+.cal-daynum {
+  font-size: 12.5px;
+  font-weight: 600;
+  color: var(--text);
+}
+.cal-chips {
+  display: flex;
+  flex-direction: column;
+  gap: 2px;
+  min-width: 0;
+}
+.cal-chip {
+  display: flex;
+  align-items: center;
+  gap: 4px;
+  font-size: 11px;
+  line-height: 1.5;
+  padding: 1px 6px;
+  border-radius: var(--radius-pill);
+  background: var(--surface-2);
+  color: var(--text);
+  min-width: 0;
+}
+.cal-chip-text {
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+.cal-more {
+  font-size: 10.5px;
+  color: var(--text-muted);
+  padding-left: 6px;
+}
+.cal-dots {
+  display: none;
+  gap: 3px;
+  flex-wrap: wrap;
+}
+.dot {
+  width: 7px;
+  height: 7px;
+  border-radius: 50%;
+  flex-shrink: 0;
+  display: inline-block;
+}
+.dot-high {
+  background: var(--priority-high);
+}
+.dot-medium {
+  background: var(--priority-medium);
+}
+.dot-low {
+  background: var(--priority-low);
+}
+
+@media (max-width: 767px) {
+  .cal-cell {
+    min-height: 56px;
+    padding: 4px;
+  }
+  .cal-chips {
+    display: none;
+  }
+  .cal-dots {
+    display: flex;
+  }
+}
+
+.cal-week {
+  display: grid;
+  grid-template-columns: repeat(7, 1fr);
+  gap: var(--space-1);
+}
+.cal-col {
+  display: flex;
+  flex-direction: column;
+  min-width: 0;
+  border: 1px solid var(--border);
+  border-radius: var(--radius-control);
+  background: var(--surface);
+}
+.cal-col-today {
+  border-color: var(--brand);
+}
+.cal-col-head {
+  display: flex;
+  align-items: baseline;
+  justify-content: space-between;
+  gap: var(--space-2);
+  padding: var(--space-2);
+  border: none;
+  border-bottom: 1px solid var(--border);
+  background: transparent;
+  cursor: pointer;
+  border-radius: var(--radius-control) var(--radius-control) 0 0;
+  font-weight: 600;
+  font-size: 12.5px;
+  color: var(--text);
+}
+.cal-col-head:hover {
+  background: var(--surface-2);
+}
+.cal-col-weekday {
+  color: var(--text-muted);
+  font-size: 11px;
+}
+.cal-col-body {
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-1);
+  padding: var(--space-1);
+  min-height: 120px;
+  overflow-x: hidden;
+}
+.cal-empty {
+  color: var(--text-muted);
+  text-align: center;
+  font-size: 12px;
+}
+
+.cal-item {
+  display: flex;
+  align-items: center;
+  gap: 5px;
+  padding: 3px 6px;
+  border-radius: 6px;
+  background: var(--surface-2);
+  font-size: 12px;
+  min-width: 0;
+  border-left: 3px solid transparent;
+}
+.cal-item-high {
+  border-left-color: var(--priority-high);
+}
+.cal-item-medium {
+  border-left-color: var(--priority-medium);
+}
+.cal-item-low {
+  border-left-color: var(--priority-low);
+}
+.cal-item-done {
+  opacity: 0.55;
+}
+.cal-item-done .cal-item-title {
+  text-decoration: line-through;
+}
+.cal-item-time {
+  color: var(--text-muted);
+  font-variant-numeric: tabular-nums;
+  white-space: nowrap;
+}
+.cal-item-title {
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+  min-width: 0;
+  flex: 1;
+}
+.cal-item-flat {
+  background: transparent;
+  border: 1px dashed var(--border);
+}
+
+.cal-day {
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-6);
+}
+.cal-day-list {
+  list-style: none;
+  padding: 0;
+  margin: 0 0 var(--space-3);
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-2);
+}
+
+@media (max-width: 639px) {
+  .cal-week {
+    grid-auto-flow: column;
+    grid-template-columns: none;
+    grid-template-rows: repeat(7, auto);
+    overflow-x: auto;
+  }
+}
+
+/* ---------- Phase 4: dashboard widgets ---------- */
+.stat-grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
+  gap: var(--space-3);
+}
+.stat-card {
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-1);
+  padding: var(--space-4);
+}
+.stat-value {
+  font-family: var(--font-mono);
+  font-variant-numeric: tabular-nums;
+  font-size: 26px;
+  font-weight: 700;
+  line-height: 1.1;
+}
+.stat-label {
+  font-size: 12.5px;
+  font-weight: 500;
+  color: var(--text-muted);
+}
+.stat-danger .stat-value {
+  color: var(--danger-text);
+}
+.stat-warning .stat-value {
+  color: var(--warning-text);
+}
+.stat-success .stat-value {
+  color: var(--success-text);
+}
+
+.dash-columns {
+  display: grid;
+  grid-template-columns: 1fr;
+  gap: var(--space-6);
+  align-items: start;
+}
+@media (min-width: 1024px) {
+  .dash-columns {
+    grid-template-columns: minmax(0, 1fr) 360px;
+  }
+}
+
+.upnext-list {
+  list-style: none;
+  padding: 0;
+  margin: var(--space-3) 0 0;
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-2);
+}
+.upnext-item {
+  display: flex;
+  align-items: center;
+  gap: var(--space-3);
+  padding: var(--space-2);
+  border-radius: var(--radius-control);
+  border: 1px solid var(--border);
+  background: var(--surface);
+}
+.upnext-main {
+  flex: 1;
+  display: flex;
+  flex-direction: column;
+  gap: 2px;
+  align-items: flex-start;
+  min-width: 0;
+  background: transparent;
+  border: none;
+  padding: 0;
+  cursor: pointer;
+  text-align: left;
+}
+.upnext-title {
+  font-weight: 600;
+  font-size: 14px;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+  max-width: 100%;
+}
+.upnext-meta {
+  display: flex;
+  gap: var(--space-2);
+  flex-wrap: wrap;
+}
+
+.workload-list {
+  list-style: none;
+  padding: 0;
+  margin: var(--space-3) 0 0;
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-3);
+}
+.workload-row {
+  display: grid;
+  grid-template-columns: minmax(80px, 120px) 1fr auto;
+  gap: var(--space-3);
+  align-items: center;
+  font-size: 13px;
+}
+.workload-name {
+  font-weight: 600;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+.workload-bar {
+  height: 10px;
+  border-radius: var(--radius-pill);
+  background: var(--surface-2);
+  overflow: hidden;
+}
+.workload-fill {
+  display: block;
+  height: 100%;
+  border-radius: var(--radius-pill);
+  background: var(--brand);
+}
+.workload-count {
+  color: var(--text-muted);
+  font-size: 12px;
+  white-space: nowrap;
+}
+
+.activity-list {
+  list-style: none;
+  padding: 0;
+  margin: var(--space-3) 0 0;
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-2);
+}
+.activity-item {
+  display: flex;
+  align-items: center;
+  gap: var(--space-2);
+  font-size: 13px;
+  min-width: 0;
+}
+.activity-icon {
+  display: inline-grid;
+  place-items: center;
+  width: 20px;
+  height: 20px;
+  border-radius: 50%;
+  background: var(--surface-2);
+  color: var(--text-muted);
+  flex-shrink: 0;
+}
+.activity-done {
+  background: var(--success-soft);
+  color: var(--success-text);
+}
+.activity-title {
+  flex: 1;
+  min-width: 0;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+.activity-when {
+  white-space: nowrap;
+  font-size: 12px;
+}
+
+/* ---------- Phase 5: notification bell, panel, page ---------- */
+.bell-wrap {
+  position: relative;
+}
+.bell-badge {
+  position: absolute;
+  top: 2px;
+  right: 0;
+  min-width: 16px;
+  height: 16px;
+  padding: 0 4px;
+  border-radius: var(--radius-pill);
+  background: var(--danger);
+  color: #fff;
+  font-size: 10.5px;
+  font-weight: 700;
+  display: grid;
+  place-items: center;
+  line-height: 1;
+}
+.notif-panel {
+  position: absolute;
+  top: calc(100% + 8px);
+  right: 0;
+  width: min(360px, calc(100vw - 24px));
+  padding: var(--space-3) var(--space-2);
+  z-index: var(--z-dropdown);
+}
+.notif-head {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  padding: 0 var(--space-2) var(--space-2);
+  font-size: 13.5px;
+}
+.notif-list {
+  list-style: none;
+  margin: 0;
+  padding: 0;
+  display: flex;
+  flex-direction: column;
+}
+.notif-item {
+  display: flex;
+  gap: var(--space-2);
+  width: 100%;
+  text-align: left;
+  background: transparent;
+  border: none;
+  border-radius: var(--radius-control);
+  padding: var(--space-2);
+  cursor: pointer;
+  font-size: 13px;
+}
+.notif-item:hover {
+  background: var(--surface-2);
+}
+.notif-dot {
+  width: 8px;
+  height: 8px;
+  border-radius: 50%;
+  background: var(--brand);
+  margin-top: 5px;
+  flex-shrink: 0;
+}
+.notif-unread .notif-dot,
+.notif-row.notif-unread .notif-dot {
+  visibility: visible;
+}
+.notif-item:not(.notif-unread) .notif-dot {
+  visibility: hidden;
+}
+.notif-body {
+  display: flex;
+  flex-direction: column;
+  gap: 2px;
+  min-width: 0;
+}
+.notif-title {
+  font-weight: 600;
+}
+.notif-text {
+  color: var(--text-muted);
+  display: -webkit-box;
+  -webkit-line-clamp: 2;
+  -webkit-box-orient: vertical;
+  overflow: hidden;
+}
+
+.notif-page-list {
+  list-style: none;
+  margin: 0;
+  padding: 0;
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-3);
+}
+.notif-row {
+  display: flex;
+  gap: var(--space-4);
+  align-items: flex-start;
+  justify-content: space-between;
+  padding: var(--space-4);
+}
+.notif-row.notif-unread {
+  border-color: var(--brand);
+}
+.notif-row-main {
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-1);
+  min-width: 0;
+}
+.notif-row-title {
+  display: flex;
+  gap: var(--space-2);
+  align-items: baseline;
+  font-weight: 600;
+}
+.notif-row-title .notif-dot {
+  margin-top: 0;
+}
+.notif-row-body {
+  font-size: 13.5px;
+  color: var(--text-muted);
+}
+.notif-row-when {
+  font-size: 12px;
+}
+.notif-row-actions {
+  display: flex;
+  gap: var(--space-1);
+  align-items: center;
+  flex-shrink: 0;
+  flex-wrap: wrap;
+  justify-content: flex-end;
+}
+
+@media (max-width: 639px) {
+  .notif-row {
+    flex-direction: column;
+  }
+  .notif-row-actions {
+    justify-content: flex-start;
+  }
+}
+
+/* ---------- Phase 6: analytics charts ---------- */
+.chart-wrap {
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-2);
+}
+.chart-svg {
+  width: 100%;
+  height: 180px;
+  display: block;
+}
+.bar-created {
+  fill: var(--brand);
+  opacity: 0.45;
+}
+.bar-done {
+  fill: var(--success);
+}
+.chart-axis {
+  stroke: var(--border);
+  stroke-width: 1;
+}
+.chart-caption {
+  display: flex;
+  gap: var(--space-4);
+  font-size: 12px;
+  color: var(--text-muted);
+  flex-wrap: wrap;
+}
+.legend {
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+}
+.sw {
+  width: 10px;
+  height: 10px;
+  border-radius: 3px;
+  display: inline-block;
+}
+.sw-created {
+  background: var(--brand);
+  opacity: 0.45;
+}
+.sw-done {
+  background: var(--success);
+}
+.stat-delta {
+  font-size: 12px;
+}
+.analytics-columns {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
+  gap: var(--space-6);
+}
+.chart-hint {
+  font-size: 12px;
+  font-weight: 400;
+}
+.dist-list {
+  list-style: none;
+  margin: var(--space-3) 0 0;
+  padding: 0;
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-3);
+}
+.dist-row {
+  display: grid;
+  grid-template-columns: minmax(72px, 110px) 1fr 56px;
+  gap: var(--space-3);
+  align-items: center;
+  font-size: 13px;
+}
+.dist-name {
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+  font-weight: 600;
+}
+.dist-bar {
+  display: flex;
+  height: 12px;
+  border-radius: var(--radius-pill);
+  background: var(--surface-2);
+  overflow: hidden;
+}
+.dist-seg {
+  display: block;
+  height: 100%;
+}
+.dist-done {
+  background: var(--success);
+}
+.dist-open {
+  background: var(--brand);
+  opacity: 0.45;
+}
+.dist-count {
+  text-align: right;
+  color: var(--text-muted);
+  font-variant-numeric: tabular-nums;
+}
+
+/* ---------- Phase 7: filter bar + FAB ---------- */
+.filter-bar {
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-3);
+  padding: var(--space-3) var(--space-4);
+}
+.filter-search {
+  position: relative;
+  max-width: 420px;
+}
+.filter-search-icon {
+  position: absolute;
+  left: 10px;
+  top: 50%;
+  transform: translateY(-50%);
+  color: var(--text-muted);
+  pointer-events: none;
+}
+.filter-search .input {
+  padding-left: 34px;
+}
+.filter-search .input::-webkit-search-cancel-button {
+  -webkit-appearance: none;
+}
+.filter-groups {
+  display: flex;
+  flex-wrap: wrap;
+  gap: var(--space-2) var(--space-4);
+}
+.filter-group {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 4px;
+  align-items: center;
+}
+.filter-foot {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: var(--space-3);
+  flex-wrap: wrap;
+}
+
+.fab {
+  display: none;
+  position: fixed;
+  right: var(--space-4);
+  bottom: calc(var(--touch-target) + var(--space-6) + env(safe-area-inset-bottom, 0px));
+  width: 52px;
+  height: 52px;
+  border-radius: 50%;
+  padding: 0;
+  box-shadow: var(--shadow-raised);
+  z-index: var(--z-sticky);
+}
+@media (max-width: 767px) {
+  .fab {
+    display: inline-grid;
+    place-items: center;
+  }
+  .app-main {
+    padding-bottom: calc(var(--touch-target) + 96px);
+  }
+}
diff --git a/client/src/styles/design-system.css b/client/src/styles/design-system.css
new file mode 100644
index 0000000..af6e003
--- /dev/null
+++ b/client/src/styles/design-system.css
@@ -0,0 +1,426 @@
+/* ==========================================================================
+   STMS Design System — DESIGN.md §2–§4, §9
+   Tokens first (light + dark), then base element styles. Component classes
+   are added per phase; everything sources colors/spacing from these tokens
+   (AGENTS.md §4: no hardcoded hex/px outside this file).
+   ========================================================================== */
+
+/* ---------- Tokens: light theme (default) ---------- */
+:root {
+  color-scheme: light dark;
+
+  /* Brand */
+  --brand: #4f46e5;
+  --brand-hover: #4338ca;
+  --brand-soft: #eef2ff;
+  --brand-text: #3730a3;
+
+  /* Surfaces */
+  --bg: #f8fafc;
+  --surface: #ffffff;
+  --surface-2: #f1f5f9;
+  --border: #e2e8f0;
+
+  /* Text */
+  --text: #0f172a;
+  --text-muted: #64748b;
+
+  /* Semantic */
+  --danger: #dc2626;
+  --danger-soft: #fef2f2;
+  --danger-text: #b91c1c;
+  --warning: #d97706;
+  --warning-soft: #fffbeb;
+  --warning-text: #b45309;
+  --success: #16a34a;
+  --success-soft: #f0fdf4;
+  --success-text: #15803d;
+
+  /* Priority (DESIGN.md §2 — dot + label, never color alone) */
+  --priority-high: #dc2626;
+  --priority-high-soft: #fef2f2;
+  --priority-high-text: #b91c1c;
+  --priority-medium: #d97706;
+  --priority-medium-soft: #fffbeb;
+  --priority-medium-text: #b45309;
+  --priority-low: #0891b2;
+  --priority-low-soft: #ecfeff;
+  --priority-low-text: #0e7490;
+
+  /* Task type accents */
+  --type-assignment: #4f46e5;
+  --type-project: #7c3aed;
+  --type-exam: #dc2626;
+  --type-study: #16a34a;
+  --type-other: #64748b;
+
+  /* Spacing scale (4px base) */
+  --space-1: 4px;
+  --space-2: 8px;
+  --space-3: 12px;
+  --space-4: 16px;
+  --space-6: 24px;
+  --space-8: 32px;
+  --space-12: 48px;
+
+  /* Radius */
+  --radius-card: 12px;
+  --radius-control: 8px;
+  --radius-pill: 999px;
+  --radius-modal: 16px;
+
+  /* Shadows */
+  --shadow-card: 0 1px 2px rgb(15 23 42 / 0.06);
+  --shadow-raised: 0 12px 32px rgb(15 23 42 / 0.16);
+
+  /* Z-index layers */
+  --z-nav: 10;
+  --z-dropdown: 20;
+  --z-sticky: 30;
+  --z-modal: 50;
+  --z-toast: 60;
+
+  /* Typography (system stack — zero network dependency) */
+  --font-sans:
+    -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
+  --font-mono: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
+
+  /* Layout */
+  --sidebar-width: 240px;
+  --content-max-width: 1200px;
+  --touch-target: 44px;
+}
+
+/* ---------- Tokens: dark theme ---------- */
+:root[data-theme='dark'] {
+  color-scheme: dark;
+
+  --brand: #6366f1;
+  --brand-hover: #818cf8;
+  --brand-soft: #1e1b4b;
+  --brand-text: #c7d2fe;
+
+  --bg: #0b1220;
+  --surface: #111a2e;
+  --surface-2: #1a2540;
+  --border: #263352;
+
+  --text: #e2e8f0;
+  --text-muted: #94a3b8;
+
+  --danger: #f87171;
+  --danger-soft: #450a0a;
+  --danger-text: #fca5a5;
+  --warning: #fbbf24;
+  --warning-soft: #451a03;
+  --warning-text: #fcd34d;
+  --success: #4ade80;
+  --success-soft: #052e16;
+  --success-text: #86efac;
+
+  --priority-high: #f87171;
+  --priority-high-soft: #450a0a;
+  --priority-high-text: #fca5a5;
+  --priority-medium: #fbbf24;
+  --priority-medium-soft: #451a03;
+  --priority-medium-text: #fcd34d;
+  --priority-low: #22d3ee;
+  --priority-low-soft: #083344;
+  --priority-low-text: #67e8f9;
+}
+
+@media (prefers-color-scheme: dark) {
+  :root:not([data-theme='light']) {
+    --brand: #6366f1;
+    --brand-hover: #818cf8;
+    --brand-soft: #1e1b4b;
+    --brand-text: #c7d2fe;
+
+    --bg: #0b1220;
+    --surface: #111a2e;
+    --surface-2: #1a2540;
+    --border: #263352;
+
+    --text: #e2e8f0;
+    --text-muted: #94a3b8;
+
+    --danger: #f87171;
+    --danger-soft: #450a0a;
+    --danger-text: #fca5a5;
+    --warning: #fbbf24;
+    --warning-soft: #451a03;
+    --warning-text: #fcd34d;
+    --success: #4ade80;
+    --success-soft: #052e16;
+    --success-text: #86efac;
+
+    --priority-high: #f87171;
+    --priority-high-soft: #450a0a;
+    --priority-high-text: #fca5a5;
+    --priority-medium: #fbbf24;
+    --priority-medium-soft: #451a03;
+    --priority-medium-text: #fcd34d;
+    --priority-low: #22d3ee;
+    --priority-low-soft: #083344;
+    --priority-low-text: #67e8f9;
+  }
+}
+
+/* ---------- Base ---------- */
+*,
+*::before,
+*::after {
+  box-sizing: border-box;
+}
+
+* {
+  margin: 0;
+}
+
+html {
+  -webkit-text-size-adjust: 100%;
+}
+
+body {
+  font-family: var(--font-sans);
+  font-size: 14.5px;
+  line-height: 1.5;
+  color: var(--text);
+  background: var(--bg);
+  -webkit-font-smoothing: antialiased;
+  text-rendering: optimizeLegibility;
+}
+
+h1 {
+  font-size: 28px;
+  font-weight: 700;
+  line-height: 1.2;
+}
+h2 {
+  font-size: 20px;
+  font-weight: 600;
+  line-height: 1.2;
+}
+h3 {
+  font-size: 16px;
+  font-weight: 600;
+  line-height: 1.2;
+}
+
+img,
+svg {
+  display: block;
+  max-width: 100%;
+}
+
+button,
+input,
+select,
+textarea {
+  font: inherit;
+  color: inherit;
+}
+
+/* Accessibility: visible focus everywhere (DESIGN.md §9) */
+:focus-visible {
+  outline: 2px solid var(--brand);
+  outline-offset: 2px;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  *,
+  *::before,
+  *::after {
+    animation-duration: 0.01ms !important;
+    animation-iteration-count: 1 !important;
+    transition-duration: 0.01ms !important;
+    scroll-behavior: auto !important;
+  }
+}
+
+/* ---------- Primitive components (foundation for all phases) ---------- */
+.card {
+  background: var(--surface);
+  border: 1px solid var(--border);
+  border-radius: var(--radius-card);
+  box-shadow: var(--shadow-card);
+  padding: var(--space-6);
+}
+
+.btn {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: var(--space-2);
+  min-height: 40px;
+  padding: var(--space-2) var(--space-4);
+  border: 1px solid transparent;
+  border-radius: var(--radius-control);
+  font-size: 14px;
+  font-weight: 600;
+  line-height: 1.2;
+  cursor: pointer;
+  text-decoration: none;
+  transition:
+    background-color 150ms ease,
+    border-color 150ms ease,
+    color 150ms ease;
+}
+.btn:disabled {
+  opacity: 0.6;
+  cursor: not-allowed;
+}
+.btn-primary {
+  background: var(--brand);
+  color: #ffffff;
+}
+.btn-primary:hover:not(:disabled) {
+  background: var(--brand-hover);
+}
+.btn-secondary {
+  background: var(--surface);
+  border-color: var(--border);
+  color: var(--text);
+}
+.btn-secondary:hover:not(:disabled) {
+  background: var(--surface-2);
+}
+.btn-danger {
+  background: var(--danger);
+  color: #ffffff;
+}
+.btn-danger:hover:not(:disabled) {
+  filter: brightness(0.92);
+}
+.btn-ghost {
+  background: transparent;
+  color: var(--text-muted);
+}
+.btn-ghost:hover:not(:disabled) {
+  background: var(--surface-2);
+  color: var(--text);
+}
+.btn-small {
+  min-height: 32px;
+  padding: var(--space-1) var(--space-3);
+  font-size: 12.5px;
+}
+
+.input {
+  width: 100%;
+  min-height: 40px;
+  padding: var(--space-2) var(--space-3);
+  background: var(--surface);
+  border: 1px solid var(--border);
+  border-radius: var(--radius-control);
+  color: var(--text);
+  transition: border-color 150ms ease;
+}
+.input::placeholder {
+  color: var(--text-muted);
+}
+.input:focus {
+  border-color: var(--brand);
+  outline: none;
+  box-shadow: 0 0 0 3px var(--brand-soft);
+}
+.input[aria-invalid='true'] {
+  border-color: var(--danger);
+}
+textarea.input {
+  min-height: 96px;
+  resize: vertical;
+}
+
+.field-error {
+  margin-top: var(--space-1);
+  font-size: 12.5px;
+  font-weight: 500;
+  color: var(--danger-text);
+}
+
+.text-muted {
+  color: var(--text-muted);
+}
+.text-danger {
+  color: var(--danger-text);
+}
+.text-success {
+  color: var(--success-text);
+}
+
+.badge {
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  padding: 2px 10px;
+  border-radius: var(--radius-pill);
+  font-size: 12.5px;
+  font-weight: 500;
+  line-height: 1.6;
+  white-space: nowrap;
+}
+.badge-dot {
+  width: 8px;
+  height: 8px;
+  border-radius: 50%;
+  background: currentColor;
+  flex-shrink: 0;
+}
+.badge-high {
+  background: var(--priority-high-soft);
+  color: var(--priority-high-text);
+}
+.badge-medium {
+  background: var(--priority-medium-soft);
+  color: var(--priority-medium-text);
+}
+.badge-low {
+  background: var(--priority-low-soft);
+  color: var(--priority-low-text);
+}
+
+/* Skeleton loading (DESIGN.md §7) */
+.skeleton {
+  position: relative;
+  overflow: hidden;
+  background: var(--surface-2);
+  border-radius: var(--radius-control);
+}
+.skeleton::after {
+  content: '';
+  position: absolute;
+  inset: 0;
+  transform: translateX(-100%);
+  background: linear-gradient(90deg, transparent, rgb(255 255 255 / 0.4), transparent);
+  animation: shimmer 1.5s infinite;
+}
+:root[data-theme='dark'] .skeleton::after {
+  background: linear-gradient(90deg, transparent, rgb(255 255 255 / 0.08), transparent);
+}
+.skeleton-line {
+  display: inline-block;
+  width: 120px;
+  height: 14px;
+  vertical-align: middle;
+}
+@keyframes shimmer {
+  100% {
+    transform: translateX(100%);
+  }
+}
+
+/* Phase 0 scaffold page */
+.scaffold-page {
+  min-height: 100vh;
+  display: grid;
+  place-items: center;
+  padding: var(--space-6);
+}
+.scaffold-card {
+  max-width: 560px;
+  width: 100%;
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-4);
+}
