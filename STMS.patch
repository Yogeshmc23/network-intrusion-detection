+# Multi-stage per DEPLOYMENT.md §4. Runtime relies on better-sqlite3 bundled prebuilds (no compilers).
+FROM node:22-alpine AS build
+WORKDIR /app
+COPY package*.json ./
+COPY shared/package.json shared/
+COPY server/package.json server/
+COPY client/package.json client/
+RUN npm ci
+COPY . .
+RUN npm run build
+
+FROM node:22-alpine
+ENV NODE_ENV=production PORT=3000 DB_PATH=/data/stms.sqlite
+WORKDIR /app
+COPY package*.json ./
+COPY shared/package.json server/package.json client/package.json ./
+COPY --from=build /app/node_modules ./node_modules
+COPY --from=build /app/shared/dist ./shared/dist
+COPY --from=build /app/server/dist ./server/dist
+COPY --from=build /app/server/public ./server/public
+VOLUME /data
+EXPOSE 3000
+HEALTHCHECK --interval=30s --timeout=5s CMD wget -qO- http://127.0.0.1:3000/api/health | grep -q '"status":"ok"'
+CMD ["node", "server/dist/index.js"]
