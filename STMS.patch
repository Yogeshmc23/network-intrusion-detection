@@ -0,0 +1,32 @@
+/**
+ * Session middleware (ARCHITECTURE.md §4): resolves the httpOnly cookie into
+ * req.userId on every request. Never trusts client-side auth — every protected
+ * route goes through requireAuth, and resource ownership is enforced in repos.
+ */
+import type { NextFunction, Request, RequestHandler, Response } from 'express';
+import type { AppConfig } from '../config.js';
+import type { Db } from '../db/connection.js';
+import { httpError } from '../util/httpError.js';
+import { resolveSession } from '../modules/auth/service.js';
+
+export function sessionMiddleware(config: AppConfig, db: Db): RequestHandler {
+  return (req: Request, _res: Response, next: NextFunction) => {
+    const raw = req.cookies?.[config.SESSION_COOKIE_NAME];
+    if (typeof raw === 'string' && raw.length > 0) {
+      const resolved = resolveSession(config, db, raw);
+      if (resolved) {
+        req.userId = resolved.userId;
+        req.authUser = resolved.user;
+      }
+    }
+    next();
+  };
+}
+
+export const requireAuth: RequestHandler = (req, _res, next) => {
+  if (req.userId === undefined) {
+    next(httpError.unauthenticated());
+    return;
+  }
+  next();
+};
diff --git a/server/src/middleware/validate.ts b/server/src/middleware/validate.ts
new file mode 100644
index 0000000..e31cacc
--- /dev/null
+++ b/server/src/middleware/validate.ts
@@ -0,0 +1,52 @@
+/**
+ * Request validation with shared zod schemas (AGENTS.md §3).
+ * Parsed (and transformed) input replaces req.body / lands in res.locals for
+ * query+params (Express 5 defines req.query as a getter — it cannot be reassigned).
+ */
+import type { RequestHandler } from 'express';
+import type { ZodError, ZodTypeAny } from 'zod';
+import type { FieldDetail } from '@stms/shared';
+import { httpError } from '../util/httpError.js';
+
+function toDetails(error: ZodError): FieldDetail[] {
+  return error.issues.map((issue) => ({
+    field: issue.path.join('.') || '(root)',
+    message: issue.message,
+  }));
+}
+
+export function validateBody<S extends ZodTypeAny>(schema: S): RequestHandler {
+  return (req, _res, next) => {
+    const result = schema.safeParse(req.body);
+    if (!result.success) {
+      next(httpError.badRequest('Validation failed.', toDetails(result.error)));
+      return;
+    }
+    req.body = result.data;
+    next();
+  };
+}
+
+export function validateQuery<S extends ZodTypeAny>(schema: S): RequestHandler {
+  return (req, res, next) => {
+    const result = schema.safeParse(req.query);
+    if (!result.success) {
+      next(httpError.badRequest('Validation failed.', toDetails(result.error)));
+      return;
+    }
+    res.locals.query = result.data;
+    next();
+  };
+}
+
+export function validateParams<S extends ZodTypeAny>(schema: S): RequestHandler {
+  return (req, res, next) => {
+    const result = schema.safeParse(req.params);
+    if (!result.success) {
+      next(httpError.badRequest('Validation failed.', toDetails(result.error)));
+      return;
+    }
+    res.locals.params = result.data;
+    next();
+  };
+}
