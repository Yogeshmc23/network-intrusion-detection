+/** Analytics route (API.md §2): GET /api/analytics/overview?days=14|30. */
+import { Router, type Request, type Response } from 'express';
+import { analyticsQuerySchema, type AnalyticsQuery } from '@stms/shared';
+import type { Db } from '../../db/connection.js';
+import { asyncHandler } from '../../util/asyncHandler.js';
+import { validateQuery } from '../../middleware/validate.js';
+import type { RateLimiters } from '../../middleware/rateLimit.js';
+import { overview } from './service.js';
+
+export function createAnalyticsRouter({
+  db,
+  limiters,
+}: {
+  db: Db;
+  limiters: Pick<RateLimiters, 'readLimiter'>;
+}): Router {
+  const router = Router();
+
+  router.get(
+    '/overview',
+    limiters.readLimiter,
+    validateQuery(analyticsQuerySchema),
+    asyncHandler(async (req: Request, res: Response) => {
+      const q = res.locals.query as AnalyticsQuery;
+      res.json(overview(db, req.userId!, q.days));
+    }),
+  );
+
+  return router;
+}
diff --git a/server/src/modules/analytics/service.ts b/server/src/modules/analytics/service.ts
new file mode 100644
index 0000000..4568d42
--- /dev/null
+++ b/server/src/modules/analytics/service.ts
@@ -0,0 +1,153 @@
+/**
+ * Progress analytics (F8). All numbers are SQL aggregates over the caller's
+ * rows — zero-filled trend buckets so charts never lie about gaps; period
+ * comparison = last N days vs the N days before that (API.md).
+ */
+import type { AnalyticsOverview, TaskPriority, TaskType } from '@stms/shared';
+import { PRIORITY_RANK, TASK_PRIORITIES, TASK_TYPES } from '@stms/shared';
+import type { Db } from '../../db/connection.js';
+import { DAY_MS, dueBucketBoundaries, toIso } from '../../util/time.js';
+
+/** UTC day part (YYYY-MM-DD) of an ISO timestamp. */
+function dayOf(iso: string): string {
+  return iso.slice(0, 10);
+}
+
+export function overview(db: Db, userId: number, days: number): AnalyticsOverview {
+  const b = dueBucketBoundaries(Date.now(), 0);
+
+  const totals = db
+    .prepare(
+      `SELECT
+        COUNT(*) AS created,
+        SUM(status = 'completed') AS completed,
+        SUM(status != 'completed') AS open,
+        SUM(due_at IS NOT NULL AND due_at < ? AND status != 'completed') AS overdue
+       FROM tasks WHERE user_id = ?`,
+    )
+    .get(b.nowIso, userId) as {
+    created: number;
+    completed: number;
+    open: number;
+    overdue: number;
+  };
+
+  const nowMs = Date.parse(b.nowIso);
+  const periodStart = toIso(nowMs - days * DAY_MS);
+  const prevStart = toIso(nowMs - 2 * days * DAY_MS);
+
+  const periods = db
+    .prepare(
+      `SELECT
+        SUM(completed_at >= ?) AS last_n,
+        SUM(completed_at >= ? AND completed_at < ?) AS prev_n
+       FROM tasks WHERE user_id = ? AND status = 'completed' AND completed_at >= ?`,
+    )
+    .get(periodStart, prevStart, periodStart, userId, prevStart) as {
+    last_n: number | null;
+    prev_n: number | null;
+  };
+
+  // ---- trend: exactly `days` day-aligned UTC buckets ending today ----
+  const todayMs = Date.parse(dayOf(b.nowIso) + 'T00:00:00.000Z');
+  const startMs = todayMs - (days - 1) * DAY_MS;
+  const dayAlignedStart = new Date(startMs).toISOString();
+
+  const trendRows = db
+    .prepare(
+      `SELECT
+        substr(completed_at, 1, 10) AS cday,
+        COUNT(*) AS n
+       FROM tasks
+       WHERE user_id = ? AND status = 'completed' AND completed_at >= ?
+       GROUP BY cday`,
+    )
+    .all(userId, dayAlignedStart) as { cday: string; n: number }[];
+  const createdRows = db
+    .prepare(
+      `SELECT substr(created_at, 1, 10) AS cday, COUNT(*) AS n
+       FROM tasks WHERE user_id = ? AND created_at >= ?
+       GROUP BY cday`,
+    )
+    .all(userId, dayAlignedStart) as { cday: string; n: number }[];
+
+  const byDay = new Map<string, { completed: number; created: number }>();
+  for (let i = 0; i < days; i++) {
+    const key = new Date(startMs + i * DAY_MS).toISOString().slice(0, 10);
+    byDay.set(key, { completed: 0, created: 0 });
+  }
+  for (const r of trendRows) {
+    const slot = byDay.get(r.cday);
+    if (slot) slot.completed = r.n;
+  }
+  for (const r of createdRows) {
+    const slot = byDay.get(r.cday);
+    if (slot) slot.created = r.n;
+  }
+
+  const byPriorityRows = db
+    .prepare(
+      `SELECT priority,
+        SUM(status != 'completed') AS open,
+        SUM(status = 'completed') AS completed
+       FROM tasks WHERE user_id = ? GROUP BY priority`,
+    )
+    .all(userId) as { priority: TaskPriority; open: number; completed: number }[];
+  // Fixed order high → medium → low; every level present even when count is 0.
+  const byPriority = TASK_PRIORITIES.map((p) => {
+    const row = byPriorityRows.find((r) => r.priority === p);
+    return { priority: p, open: row?.open ?? 0, completed: row?.completed ?? 0 };
+  }).sort((a, x) => PRIORITY_RANK[x.priority] - PRIORITY_RANK[a.priority]);
+
+  const bySubject = db
+    .prepare(
+      `SELECT subject,
+        SUM(status != 'completed') AS open,
+        SUM(status = 'completed') AS completed
+       FROM tasks WHERE user_id = ?
+       GROUP BY subject ORDER BY COUNT(*) DESC, subject COLLATE NOCASE ASC`,
+    )
+    .all(userId) as { subject: string; open: number; completed: number }[];
+
+  const byTypeRows = db
+    .prepare(
+      `SELECT type,
+        SUM(status != 'completed') AS open,
+        SUM(status = 'completed') AS completed
+       FROM tasks WHERE user_id = ? GROUP BY type`,
+    )
+    .all(userId) as { type: TaskType; open: number; completed: number }[];
+  const byType = TASK_TYPES.map((t) => {
+    const row = byTypeRows.find((r) => r.type === t);
+    return { type: t, open: row?.open ?? 0, completed: row?.completed ?? 0 };
+  }).filter((r) => r.open > 0 || r.completed > 0);
+
+  const total = totals.created ?? 0;
+  const completed = totals.completed ?? 0;
+
+  return {
+    totals: {
+      created: total,
+      completed,
+      open: totals.open ?? 0,
+      overdue: totals.overdue ?? 0,
+    },
+    completionRate: total === 0 ? null : Math.round((completed / total) * 1000) / 1000,
+    completedLastPeriod: periods.last_n ?? 0,
+    completedPreviousPeriod: periods.prev_n ?? 0,
+    trend: [...byDay.entries()]
+      .sort(([a], [x]) => (a < x ? -1 : 1))
+      .map(([date, v]) => ({ date, completed: v.completed, created: v.created })),
+    byPriority: byPriority.map(({ priority, open, completed: c }) => ({
+      priority,
+      open: open ?? 0,
+      completed: c ?? 0,
+    })),
+    bySubject: bySubject.map((r) => ({
+      subject: r.subject,
+      open: r.open ?? 0,
+      completed: r.completed ?? 0,
+    })),
+    byType,
+  };
+}
diff --git a/server/src/modules/auth/repo.ts b/server/src/modules/auth/repo.ts
new file mode 100644
index 0000000..94d6135
--- /dev/null
+++ b/server/src/modules/auth/repo.ts
@@ -0,0 +1,114 @@
+/**
+ * Data access for users + sessions (AGENTS.md §6: all SQL here, all parameterized,
+ * ownership scoping on user-owned resources).
+ */
+import type { Db } from '../../db/connection.js';
+
+export interface UserRow {
+  id: number;
+  name: string;
+  email: string;
+  password_hash: string;
+  email_reminders_enabled: number;
+  created_at: string;
+  updated_at: string;
+}
+
+export interface SessionRow {
+  token_hash: string;
+  user_id: number;
+  created_at: string;
+  expires_at: string;
+}
+
+const USER_COLUMNS = `id, name, email, password_hash, email_reminders_enabled, created_at, updated_at`;
+
+export function findUserByEmail(db: Db, email: string): UserRow | undefined {
+  return db.prepare(`SELECT ${USER_COLUMNS} FROM users WHERE email = ?`).get(email) as
+    UserRow | undefined;
+}
+
+export function findUserById(db: Db, id: number): UserRow | undefined {
+  return db.prepare(`SELECT ${USER_COLUMNS} FROM users WHERE id = ?`).get(id) as
+    UserRow | undefined;
+}
+
+export function insertUser(
+  db: Db,
+  input: { name: string; email: string; passwordHash: string; now: string },
+): UserRow {
+  const tx = db.transaction(() => {
+    const info = db
+      .prepare(
+        `INSERT INTO users (name, email, password_hash, created_at, updated_at)
+         VALUES (?, ?, ?, ?, ?)`,
+      )
+      .run(input.name, input.email, input.passwordHash, input.now, input.now);
+    // Welcome notification — one per user, at registration only (API.md §2).
+    db.prepare(
+      `INSERT INTO notifications (user_id, task_id, kind, title, body, created_at)
+       VALUES (?, NULL, 'welcome', ?, ?, ?)`,
+    ).run(
+      Number(info.lastInsertRowid),
+      'Welcome to the Student Task Manager 🎓',
+      'Create your first task with a subject, priority and due date — reminders will show up here before deadlines.',
+      input.now,
+    );
+    return findUserById(db, Number(info.lastInsertRowid))!;
+  });
+  return tx();
+}
+
+export function updateUserProfile(
+  db: Db,
+  id: number,
+  patch: { name?: string; emailRemindersEnabled?: boolean },
+  now: string,
+): UserRow {
+  const sets: string[] = ['updated_at = ?'];
+  const params: (string | number)[] = [now];
+  if (patch.name !== undefined) {
+    sets.push('name = ?');
+    params.push(patch.name);
+  }
+  if (patch.emailRemindersEnabled !== undefined) {
+    sets.push('email_reminders_enabled = ?');
+    params.push(patch.emailRemindersEnabled ? 1 : 0);
+  }
+  params.push(id);
+  db.prepare(`UPDATE users SET ${sets.join(', ')} WHERE id = ?`).run(...params);
+  return findUserById(db, id)!;
+}
+
+export function updateUserPassword(db: Db, id: number, passwordHash: string, now: string): void {
+  db.prepare('UPDATE users SET password_hash = ?, updated_at = ? WHERE id = ?').run(
+    passwordHash,
+    now,
+    id,
+  );
+}
+
+export function createSession(
+  db: Db,
+  input: { tokenHash: string; userId: number; now: string; expiresAt: string },
+): void {
+  db.prepare(
+    'INSERT INTO sessions (token_hash, user_id, created_at, expires_at) VALUES (?, ?, ?, ?)',
+  ).run(input.tokenHash, input.userId, input.now, input.expiresAt);
+}
+
+export function findSession(db: Db, tokenHash: string): SessionRow | undefined {
+  return db
+    .prepare(
+      'SELECT token_hash, user_id, created_at, expires_at FROM sessions WHERE token_hash = ?',
+    )
+    .get(tokenHash) as SessionRow | undefined;
+}
+
+export function deleteSession(db: Db, tokenHash: string): void {
+  db.prepare('DELETE FROM sessions WHERE token_hash = ?').run(tokenHash);
+}
+
+export function touchSession(db: Db, tokenHash: string, expiresAt: string): void {
+  db.prepare('UPDATE sessions SET expires_at = ? WHERE token_hash = ?').run(expiresAt, tokenHash);
+}
diff --git a/server/src/modules/auth/routes.ts b/server/src/modules/auth/routes.ts
new file mode 100644
index 0000000..29c4ec3
--- /dev/null
+++ b/server/src/modules/auth/routes.ts
@@ -0,0 +1,122 @@
+/**
+ * Auth + profile routes (API.md §2 "Auth & profile").
+ * Cookie handling lives here (HTTP concern); business rules in service.ts.
+ */
+import { Router, type CookieOptions, type Request, type Response } from 'express';
+import {
+  loginSchema,
+  passwordChangeSchema,
+  profilePatchSchema,
+  registerSchema,
+} from '@stms/shared';
+import type { AppConfig } from '../../config.js';
+import type { Db } from '../../db/connection.js';
+import { asyncHandler } from '../../util/asyncHandler.js';
+import { httpError } from '../../util/httpError.js';
+import { validateBody } from '../../middleware/validate.js';
+import { requireAuth } from '../../middleware/session.js';
+import { createRateLimiters } from '../../middleware/rateLimit.js';
+import * as service from './service.js';
+
+export interface AuthRouterDeps {
+  config: AppConfig;
+  db: Db;
+}
+
+function cookieOptions(config: AppConfig, expiresAt: string): CookieOptions {
+  const maxAge = Math.max(0, Date.parse(expiresAt) - Date.now());
+  return {
+    httpOnly: true,
+    sameSite: config.COOKIE_SAMESITE,
+    secure: config.cookieSecure,
+    path: '/',
+    maxAge,
+  };
+}
+
+function setSessionCookie(
+  config: AppConfig,
+  res: Response,
+  token: string,
+  expiresAt: string,
+): void {
+  res.cookie(config.SESSION_COOKIE_NAME, token, cookieOptions(config, expiresAt));
+}
+
+function clearSessionCookie(config: AppConfig, res: Response): void {
+  res.clearCookie(config.SESSION_COOKIE_NAME, { path: '/' });
+}
+
+export function createAuthRouter({ config, db }: AuthRouterDeps): Router {
+  const router = Router();
+  const { authLimiter } = createRateLimiters(config);
+
+  router.post(
+    '/register',
+    authLimiter,
+    validateBody(registerSchema),
+    asyncHandler(async (req: Request, res: Response) => {
+      const session = await service.register(config, db, req.body);
+      setSessionCookie(config, res, session.token, session.expiresAt);
+      res.status(201).json({ user: session.user });
+    }),
+  );
+
+  router.post(
+    '/login',
+    authLimiter,
+    validateBody(loginSchema),
+    asyncHandler(async (req: Request, res: Response) => {
+      const session = await service.login(config, db, req.body);
+      setSessionCookie(config, res, session.token, session.expiresAt);
+      res.json({ user: session.user });
+    }),
+  );
+
+  router.post(
+    '/logout',
+    asyncHandler(async (req: Request, res: Response) => {
+      const raw = req.cookies?.[config.SESSION_COOKIE_NAME];
+      if (typeof raw === 'string') {
+        service.logout(config, db, raw);
+      }
+      clearSessionCookie(config, res);
+      res.status(204).end();
+    }),
+  );
+
+  router.get(
+    '/me',
+    requireAuth,
+    asyncHandler(async (req: Request, res: Response) => {
+      // Re-read the row so profile updates are immediately reflected.
+      const user = service.getUserById(db, req.userId!);
+      if (!user) {
+        throw httpError.unauthenticated();
+      }
+      res.json({ user });
+    }),
+  );
+
+  router.patch(
+    '/profile',
+    requireAuth,
+    validateBody(profilePatchSchema),
+    asyncHandler(async (req: Request, res: Response) => {
+      const user = service.updateProfile(db, req.userId!, req.body);
+      res.json({ user });
+    }),
+  );
+
+  router.put(
+    '/password',
+    requireAuth,
+    validateBody(passwordChangeSchema),
+    asyncHandler(async (req: Request, res: Response) => {
+      await service.changePassword(db, req.userId!, req.body);
+      res.status(204).end();
+    }),
+  );
+
+  return router;
+}
diff --git a/server/src/modules/auth/service.ts b/server/src/modules/auth/service.ts
new file mode 100644
index 0000000..3dec042
--- /dev/null
+++ b/server/src/modules/auth/service.ts
@@ -0,0 +1,164 @@
+/**
+ * Auth service (Stage 11 / ARCHITECTURE.md §4): bcrypt password handling,
+ * server-side sessions, ownership. Routes never touch SQL or bcrypt directly.
+ */
+import bcrypt from 'bcryptjs';
+import type { Db } from '../../db/connection.js';
+import type { AppConfig } from '../../config.js';
+import type { User } from '@stms/shared';
+import { httpError } from '../../util/httpError.js';
+import { generateSessionToken, hashSessionToken } from '../../util/session.js';
+import { DAY_MS, toIso } from '../../util/time.js';
+import * as repo from './repo.js';
+
+const BCRYPT_ROUNDS = 12;
+
+export interface AuthenticatedSession {
+  user: User;
+  token: string;
+  expiresAt: string;
+}
+
+function toUser(row: repo.UserRow): User {
+  return {
+    id: row.id,
+    name: row.name,
+    email: row.email,
+    emailRemindersEnabled: row.email_reminders_enabled === 1,
+    createdAt: row.created_at,
+  };
+}
+
+function sessionExpiry(config: AppConfig, nowMs: number): string {
+  return toIso(nowMs + config.SESSION_TTL_DAYS * DAY_MS);
+}
+
+async function newSession(
+  config: AppConfig,
+  db: Db,
+  userId: number,
+): Promise<{ token: string; expiresAt: string }> {
+  const token = generateSessionToken();
+  const tokenHash = hashSessionToken(config.sessionSecret, token);
+  const nowMs = Date.now();
+  const expiresAt = sessionExpiry(config, nowMs);
+  repo.createSession(db, {
+    tokenHash,
+    userId,
+    now: toIso(nowMs),
+    expiresAt,
+  });
+  return { token, expiresAt };
+}
+
+export async function register(
+  config: AppConfig,
+  db: Db,
+  input: { name: string; email: string; password: string },
+): Promise<AuthenticatedSession> {
+  if (repo.findUserByEmail(db, input.email)) {
+    throw httpError.emailTaken();
+  }
+  const passwordHash = await bcrypt.hash(input.password, BCRYPT_ROUNDS);
+  const row = repo.insertUser(db, {
+    name: input.name,
+    email: input.email,
+    passwordHash,
+    now: toIso(Date.now()),
+  });
+  const session = await newSession(config, db, row.id);
+  return { user: toUser(row), ...session };
+}
+
+// Lazily-built dummy hash so unknown-email logins still spend a bcrypt round
+// (constant-time-ish against user enumeration via response timing).
+let nopeHash: string | undefined;
+function getNopeHash(): string {
+  nopeHash ??= bcrypt.hashSync('stms-timing-equalizer-never-matches', BCRYPT_ROUNDS);
+  return nopeHash;
+}
+
+export async function login(
+  config: AppConfig,
+  db: Db,
+  input: { email: string; password: string },
+): Promise<AuthenticatedSession> {
+  const row = repo.findUserByEmail(db, input.email);
+  // Same error + comparable work for unknown email and wrong password (no enumeration).
+  const ok = row
+    ? await bcrypt.compare(input.password, row.password_hash)
+    : await bcrypt.compare(input.password, getNopeHash());
+  if (!row || !ok) {
+    throw httpError.invalidCredentials();
+  }
+  const session = await newSession(config, db, row.id);
+  return { user: toUser(row), ...session };
+}
+
+export function getUserById(db: Db, id: number): User | undefined {
+  const row = repo.findUserById(db, id);
+  return row ? toUser(row) : undefined;
+}
+
+export function updateProfile(
+  db: Db,
+  userId: number,
+  patch: { name?: string; emailRemindersEnabled?: boolean },
+): User {
+  const row = repo.updateUserProfile(db, userId, patch, toIso(Date.now()));
+  return toUser(row);
+}
+
+export async function changePassword(
+  db: Db,
+  userId: number,
+  input: { currentPassword: string; newPassword: string },
+): Promise<void> {
+  const row = repo.findUserById(db, userId);
+  if (!row) {
+    throw httpError.unauthenticated();
+  }
+  const ok = await bcrypt.compare(input.currentPassword, row.password_hash);
+  if (!ok) {
+    throw httpError.invalidCredentials();
+  }
+  const passwordHash = await bcrypt.hash(input.newPassword, BCRYPT_ROUNDS);
+  repo.updateUserPassword(db, userId, passwordHash, toIso(Date.now()));
+}
+
+// ---------- session lifecycle ----------
+
+export function resolveSession(
+  config: AppConfig,
+  db: Db,
+  rawToken: string,
+): { userId: number; user: User; refresh: boolean; expiresAt?: string } | undefined {
+  if (!/^[0-9a-f]{64}$/.test(rawToken)) return undefined;
+  const tokenHash = hashSessionToken(config.sessionSecret, rawToken);
+  const session = repo.findSession(db, tokenHash);
+  if (!session) return undefined;
+
+  const nowMs = Date.now();
+  if (Date.parse(session.expires_at) <= nowMs) {
+    repo.deleteSession(db, tokenHash); // expired → revoked (session expiry, Stage 11)
+    return undefined;
+  }
+  const userRow = repo.findUserById(db, session.user_id);
+  if (!userRow) {
+    repo.deleteSession(db, tokenHash);
+    return undefined;
+  }
+  // Sliding expiry: refresh when less than a day would remain after this request.
+  const refresh =
+    Date.parse(session.expires_at) - nowMs < config.SESSION_TTL_DAYS * DAY_MS - DAY_MS;
+  const expiresAt = refresh ? sessionExpiry(config, nowMs) : undefined;
+  if (refresh) {
+    repo.touchSession(db, tokenHash, expiresAt!);
+  }
+  return { userId: userRow.id, user: toUser(userRow), refresh, expiresAt };
+}
+
+export function logout(config: AppConfig, db: Db, rawToken: string): void {
+  if (!/^[0-9a-f]{64}$/.test(rawToken)) return;
+  repo.deleteSession(db, hashSessionToken(config.sessionSecret, rawToken));
+}
