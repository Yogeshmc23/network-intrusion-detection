+# STMS environment template — copy to .env and adjust. NEVER commit .env.
+# Empty values are treated as unset (see server/src/config.ts).
+
+# --- Core ---
+NODE_ENV=development
+# Dev API port (Vite proxies /api here). Production default is 3000.
+PORT=3001
+LOG_LEVEL=info
+# DB file path (relative paths resolve under server/). Use :memory: for tests.
+DB_PATH=
+
+# --- Sessions / cookies ---
+SESSION_COOKIE_NAME=stms_sid
+SESSION_TTL_DAYS=7
+# REQUIRED in production, min 16 chars. Used as pepper for session-token hashes.
+SESSION_SECRET=dev-only-insecure-secret
+
+# Set when running behind an HTTPS proxy (Render/Fly/e2b preview): trusts X-Forwarded-*.
+TRUST_PROXY=1
+# Use 'none' ONLY when the app is embedded cross-site (e.g., preview iframes); forces Secure cookie.
+# Standard deployments should keep 'lax' (SECURITY.md).
+COOKIE_SAMESITE=lax
+# Optional CSP frame-ancestors override (space-separated sources). Production default: 'self'.
+FRAME_ANCESTORS=
+
+# --- CORS (only for split-origin dev WITHOUT the Vite proxy; normally leave empty) ---
+CLIENT_ORIGIN=
+
+# --- Email (SMTP) — all-or-nothing. Unset => email disabled => dev outbox (ARCHITECTURE.md §6) ---
+SMTP_HOST=
+SMTP_PORT=587
+SMTP_USER=
+SMTP_PASS=
+EMAIL_FROM=
+
+# --- Rate limits (requests per minute) ---
+RATE_LIMIT_AUTH_PER_MIN=10
+RATE_LIMIT_WRITE_PER_MIN=120
+RATE_LIMIT_READ_PER_MIN=300
+
+# --- Reminder scheduler ---
+SCHEDULER_ENABLED=1
+SCHEDULER_INTERVAL_MS=60000
