+++ b/server/tests/migrate.test.ts
@@ -0,0 +1,139 @@
+/** Migration runner + schema integrity (DATABASE.md §4-§6). */
+import { describe, expect, it } from 'vitest';
+import { openDb } from '../src/db/connection.js';
+import { runMigrations } from '../src/db/migrate.js';
+
+const now = new Date().toISOString();
+
+describe('runMigrations', () => {
+  it('applies 001_init.sql once, records it, and is idempotent', () => {
+    const db = openDb(':memory:');
+    const applied = runMigrations(db);
+    expect(applied).toEqual(['001_init.sql']);
+
+    const tables = db
+      .prepare("SELECT name FROM sqlite_master WHERE type='table' ORDER BY name")
+      .all()
+      .map((row) => (row as { name: string }).name);
+    for (const expected of [
+      'users',
+      'sessions',
+      'tasks',
+      'notifications',
+      'email_queue',
+      'schema_migrations',
+    ]) {
+      expect(tables).toContain(expected);
+    }
+
+    const recorded = db.prepare('SELECT version, name FROM schema_migrations').all() as {
+      version: number;
+      name: string;
+    }[];
+    expect(recorded).toEqual([{ version: 1, name: '001_init.sql' }]);
+
+    // Second run is a no-op.
+    expect(runMigrations(db)).toEqual([]);
+    db.close();
+  });
+
+  it('creates the indexes DATABASE.md §3 requires', () => {
+    const db = openDb(':memory:');
+    runMigrations(db);
+    const indexes = db
+      .prepare("SELECT name FROM sqlite_master WHERE type='index' AND name LIKE 'idx_%'")
+      .all()
+      .map((row) => (row as { name: string }).name);
+    for (const expected of [
+      'idx_tasks_user_due',
+      'idx_tasks_user_status_due',
+      'idx_tasks_user_priority',
+      'idx_tasks_user_subject',
+      'idx_tasks_user_updated',
+      'idx_sessions_user',
+      'idx_sessions_expires',
+      'idx_notifs_user_unread',
+      'idx_notifs_user_created',
+      'idx_emailq_state',
+    ]) {
+      expect(indexes).toContain(expected);
+    }
+    db.close();
+  });
+});
+
+describe('schema integrity', () => {
+  it('enforces foreign keys (tasks belong to a real user)', () => {
+    const db = openDb(':memory:');
+    runMigrations(db);
+    expect(() =>
+      db
+        .prepare(
+          `INSERT INTO tasks (user_id, title, subject, type, created_at, updated_at)
+           VALUES (999, 'orphan', 'Math', 'exam', ?, ?)`,
+        )
+        .run(now, now),
+    ).toThrow(/FOREIGN KEY/);
+    db.close();
+  });
+
+  it('enforces CHECK constraints (enum values)', () => {
+    const db = openDb(':memory:');
+    runMigrations(db);
+    db.prepare(
+      'INSERT INTO users (name, email, password_hash, created_at, updated_at) VALUES (?, ?, ?, ?, ?)',
+    ).run('Test', 'test@example.com', 'hash', now, now);
+    expect(() =>
+      db
+        .prepare(
+          `INSERT INTO tasks (user_id, title, subject, type, priority, created_at, updated_at)
+           VALUES (1, 't', 'Math', 'invalid-type', 'high', ?, ?)`,
+        )
+        .run(now, now),
+    ).toThrow(/CHECK/);
+    db.close();
+  });
+
+  it('cascades user deletion to tasks and sessions', () => {
+    const db = openDb(':memory:');
+    runMigrations(db);
+    db.prepare(
+      'INSERT INTO users (id, name, email, password_hash, created_at, updated_at) VALUES (1, ?, ?, ?, ?, ?)',
+    ).run('Test', 'cascade@example.com', 'hash', now, now);
+    db.prepare(
+      `INSERT INTO tasks (user_id, title, subject, type, created_at, updated_at)
+       VALUES (1, 'task', 'Math', 'study', ?, ?)`,
+    ).run(now, now);
+    db.prepare(
+      'INSERT INTO sessions (token_hash, user_id, created_at, expires_at) VALUES (?, 1, ?, ?)',
+    ).run('hash1', now, now);
+
+    db.prepare('DELETE FROM users WHERE id = 1').run();
+    const tasks = db.prepare('SELECT COUNT(*) AS n FROM tasks').get() as { n: number };
+    const sessions = db.prepare('SELECT COUNT(*) AS n FROM sessions').get() as { n: number };
+    expect(tasks.n).toBe(0);
+    expect(sessions.n).toBe(0);
+    db.close();
+  });
+
+  it('deduplicates reminders via UNIQUE(user_id, kind, task_id)', () => {
+    const db = openDb(':memory:');
+    runMigrations(db);
+    db.prepare(
+      'INSERT INTO users (id, name, email, password_hash, created_at, updated_at) VALUES (1, ?, ?, ?, ?, ?)',
+    ).run('Test', 'dedup@example.com', 'hash', now, now);
+    db.prepare(
+      `INSERT INTO tasks (id, user_id, title, subject, type, created_at, updated_at)
+       VALUES (1, 1, 'task', 'Math', 'exam', ?, ?)`,
+    ).run(now, now);
+    const insert = db.prepare(
+      `INSERT OR IGNORE INTO notifications (user_id, task_id, kind, title, body, created_at)
+       VALUES (1, 1, 'overdue', 'Overdue', 'Body', ?)`,
+    );
+    insert.run(now);
+    insert.run(now); // duplicate → ignored
+    const count = db.prepare('SELECT COUNT(*) AS n FROM notifications').get() as { n: number };
+    expect(count.n).toBe(1);
+    db.close();
+  });
+});
diff --git a/server/tests/notifications.test.ts b/server/tests/notifications.test.ts
new file mode 100644
index 0000000..a1516c2
--- /dev/null
+++ b/server/tests/notifications.test.ts
@@ -0,0 +1,229 @@
+/**
+ * Phase 5 suites: reminder scan (windows, idempotency, completed exclusion),
+ * email queue + dev outbox (ARCHITECTURE.md §6 — nothing pretends to send),
+ * list/read/dismiss endpoints with ownership and auth rules.
+ */
+import fs from 'node:fs';
+import path from 'node:path';
+import { afterAll, beforeAll, describe, expect, it } from 'vitest';
+import request from 'supertest';
+import type { Agent } from 'supertest';
+import { closeTestApp, createTestApp, type TestContext } from './helpers.js';
+import { runReminderScan } from '../src/modules/notifications/service.js';
+
+const HOUR = 3_600_000;
+
+let ctx: TestContext;
+let agent: Agent; // reminders ON (default)
+let muted: Agent; // reminders OFF
+
+async function createTaskAs(a: Agent, body: Record<string, unknown>) {
+  const res = await a.post('/api/tasks').send(body).expect(201);
+  return res.body.task as { id: number };
+}
+
+beforeAll(async () => {
+  ctx = createTestApp({
+    RATE_LIMIT_AUTH_PER_MIN: '100000',
+    RATE_LIMIT_WRITE_PER_MIN: '100000',
+    RATE_LIMIT_READ_PER_MIN: '100000',
+  });
+  agent = request.agent(ctx.app);
+  muted = request.agent(ctx.app);
+  await agent
+    .post('/api/auth/register')
+    .send({ name: 'Noti', email: 'noti@t.dev', password: 'Password123!' })
+    .expect(201);
+  await muted
+    .post('/api/auth/register')
+    .send({ name: 'Muted', email: 'muted@t.dev', password: 'Password123!' })
+    .expect(201);
+  await muted.patch('/api/auth/profile').send({ emailRemindersEnabled: false }).expect(200);
+});
+
+afterAll(() => {
+  closeTestApp(ctx);
+  // remove any outbox files this suite produced (dir is gitignored anyway)
+  const outbox = path.join(process.cwd(), 'outbox');
+  if (fs.existsSync(outbox))
+    for (const f of fs.readdirSync(outbox)) fs.rmSync(path.join(outbox, f));
+});
+
+const notifCount = (email: string) =>
+  (
+    ctx.db
+      .prepare(
+        'SELECT COUNT(*) AS n FROM notifications n JOIN users u ON u.id = n.user_id WHERE u.email = ?',
+      )
+      .get(email) as { n: number }
+  ).n;
+
+describe('reminder scan (F7)', () => {
+  it('creates exactly one notification per (task, kind) and is idempotent', async () => {
+    const nowMs = Date.now();
+    const soon = new Date(nowMs + 30 * 60_000).toISOString(); // within 1h
+    const tomorrowish = new Date(nowMs + 18 * HOUR).toISOString(); // (1h, 24h]
+    const past = new Date(nowMs - 1 * HOUR).toISOString(); // overdue
+    const far = new Date(nowMs + 48 * HOUR).toISOString(); // outside all windows
+
+    await createTaskAs(agent, { title: 'due-30m', subject: 'Math', type: 'exam', dueAt: soon });
+    await createTaskAs(agent, {
+      title: 'due-18h',
+      subject: 'Math',
+      type: 'exam',
+      dueAt: tomorrowish,
+    });
+    await createTaskAs(agent, { title: 'overdue-1h', subject: 'Math', type: 'exam', dueAt: past });
+    await createTaskAs(agent, { title: 'due-48h', subject: 'Math', type: 'exam', dueAt: far });
+
+    const before = notifCount('noti@t.dev');
+    const created = runReminderScan(ctx.db, nowMs);
+    const mid = notifCount('noti@t.dev');
+    expect(created).toBe(3); // 30m→1h, 18h→24h, past→overdue; 48h task gets none
+    expect(mid - before).toBe(created);
+
+    const created2 = runReminderScan(ctx.db, nowMs);
+    expect(created2).toBe(0); // second scan: UNIQUE(user, kind, task) → nothing new
+    expect(notifCount('noti@t.dev')).toBe(mid);
+
+    // window correctness: 48h task gets NO reminder at now (but 'due-18h' got the 24h one)
+    const rows = ctx.db
+      .prepare(
+        `SELECT n.kind FROM notifications n
+         JOIN tasks t ON t.id = n.task_id
+         WHERE t.title = 'due-48h'`,
+      )
+      .all() as { kind: string }[];
+    expect(rows).toEqual([]);
+  });
+
+  it('never notifies for completed tasks', async () => {
+    const t = await createTaskAs(agent, {
+      title: 'already-done',
+      subject: 'Math',
+      type: 'exam',
+      dueAt: new Date(Date.now() - 2 * HOUR).toISOString(),
+      status: 'completed',
+    });
+    runReminderScan(ctx.db);
+    const n = ctx.db
+      .prepare('SELECT COUNT(*) AS c FROM notifications WHERE task_id = ?')
+      .get(t.id) as { c: number };
+    expect(n.c).toBe(0);
+  });
+
+  it('email reminders: queued for enabled users only; outbox+skip when SMTP is off', async () => {
+    const nowMs = Date.now();
+    await createTaskAs(agent, {
+      title: 'email-me',
+      subject: 'Math',
+      type: 'exam',
+      dueAt: new Date(nowMs + 40 * 60_000).toISOString(),
+    });
+    await createTaskAs(muted, {
+      title: 'no-email',
+      subject: 'Math',
+      type: 'exam',
+      dueAt: new Date(nowMs + 40 * 60_000).toISOString(),
+    });
+    runReminderScan(ctx.db, nowMs);
+
+    const queueFor = (email: string) =>
+      ctx.db
+        .prepare(
+          `SELECT q.state, q.to_email FROM email_queue q JOIN users u ON u.id = q.user_id WHERE u.email = ?`,
+        )
+        .all(email) as { state: string; to_email: string }[];
+
+    expect(queueFor('noti@t.dev').length).toBeGreaterThan(0);
+    expect(queueFor('muted@t.dev')).toEqual([]);
+
+    // Dev trigger drains the queue: SMTP unset in tests → skipped_no_smtp + real .eml files
+    const res = await agent.post('/api/dev/run-reminder-scan').expect(200);
+    expect(res.body.email.skipped).toBeGreaterThan(0);
+    for (const row of queueFor('noti@t.dev')) expect(row.state).toBe('skipped_no_smtp');
+
+    const outboxDir = path.join(process.cwd(), 'outbox');
+    const files = fs.existsSync(outboxDir) ? fs.readdirSync(outboxDir) : [];
+    expect(files.some((f) => f.endsWith('.eml'))).toBe(true);
+    const sample = fs.readFileSync(
+      path.join(
+        outboxDir,
+        files.find((f) => f.endsWith('.eml'))!,
+      ),
+      'utf8',
+    );
+    expect(sample).toContain('NOT sent'); // labeled, never presented as delivered
+  });
+
+  it('deleting a task removes its notifications (cascade)', async () => {
+    const t = await createTaskAs(agent, {
+      title: 'doomed-notif',
+      subject: 'Math',
+      type: 'exam',
+      dueAt: new Date(Date.now() - HOUR).toISOString(),
+    });
+    runReminderScan(ctx.db);
+    const n = ctx.db
+      .prepare('SELECT COUNT(*) AS c FROM notifications WHERE task_id = ?')
+      .get(t.id) as { c: number };
+    expect(n.c).toBe(1);
+    await agent.delete(`/api/tasks/${t.id}`).expect(204);
+    const after = ctx.db
+      .prepare('SELECT COUNT(*) AS c FROM notifications WHERE task_id = ?')
+      .get(t.id) as { c: number };
+    expect(after.c).toBe(0);
+  });
+});
+
+describe('notification endpoints (F7)', () => {
+  let firstId = 0;
+
+  it('GET / lists newest-first with unread counts', async () => {
+    const res = await agent.get('/api/notifications?limit=100').expect(200);
+    expect(res.body.total).toBeGreaterThan(1);
+    const kinds = res.body.items.map((n: { kind: string }) => n.kind);
+    expect(kinds).toContain('overdue');
+    firstId = res.body.items[0].id as number;
+    const count = await agent.get('/api/notifications/unread-count').expect(200);
+    expect(count.body.count).toBe(res.body.total); // none read yet
+  });
+
+  it('unreadOnly filter + pagination metadata', async () => {
+    const res = await agent.get('/api/notifications?unreadOnly=true&page=1&limit=1').expect(200);
+    expect(res.body.items).toHaveLength(1);
+    expect(res.body.total).toBeGreaterThan(1);
+  });
+
+  it('POST /:id/read is idempotent', async () => {
+    const one = await agent.post(`/api/notifications/${firstId}/read`).expect(200);
+    expect(one.body.notification.readAt).toBeTruthy();
+    const again = await agent.post(`/api/notifications/${firstId}/read`).expect(200);
+    expect(again.body.notification.readAt).toBe(one.body.notification.readAt);
+  });
+
+  it('rejects other users’ notifications with 404', async () => {
+    await muted.post(`/api/notifications/${firstId}/read`).expect(404);
+    await muted.delete(`/api/notifications/${firstId}`).expect(404);
+  });
+
+  it('POST /read-all then GET ?unreadOnly=true → empty', async () => {
+    await agent.post('/api/notifications/read-all').expect(204);
+    const count = await agent.get('/api/notifications/unread-count').expect(200);
+    expect(count.body.count).toBe(0);
+    const list = await agent.get('/api/notifications?unreadOnly=true').expect(200);
+    expect(list.body.items).toEqual([]);
+  });
+
+  it('DELETE dismisses; unknown/foreign ids 404', async () => {
+    const list = await agent.get('/api/notifications?limit=1').expect(200);
+    const id = list.body.items[0].id as number;
+    await agent.delete(`/api/notifications/${id}`).expect(204);
+    await agent.delete(`/api/notifications/${id}`).expect(404);
+  });
+
+  it('requires auth', async () => {
+    await request(ctx.app).get('/api/notifications').expect(401);
+    await request(ctx.app).post('/api/dev/run-reminder-scan').expect(401);
+  });
+});
diff --git a/server/tests/search-filter.test.ts b/server/tests/search-filter.test.ts
new file mode 100644
index 0000000..4860c9f
--- /dev/null
+++ b/server/tests/search-filter.test.ts
@@ -0,0 +1,125 @@
+/**
+ * Phase 7 suite: search (F9) + multi-select filtering on GET /api/tasks.
+ * Verifies combined filters AND together, values within one field OR,
+ * case-insensitive search, LIKE-wildcard escaping, and that `total` reflects
+ * the filtered set (pagination correctness).
+ */
+import { afterAll, beforeAll, describe, expect, it } from 'vitest';
+import request from 'supertest';
+import type { Agent } from 'supertest';
+import { closeTestApp, createTestApp, type TestContext } from './helpers.js';
+
+let ctx: TestContext;
+let agent: Agent;
+
+async function make(body: Record<string, unknown>) {
+  await agent.post('/api/tasks').send(body).expect(201);
+}
+
+async function titles(query: string): Promise<string[]> {
+  const res = await agent.get(`/api/tasks?limit=100&${query}`).expect(200);
+  return (res.body.items as { title: string }[]).map((t) => t.title);
+}
+
+beforeAll(async () => {
+  ctx = createTestApp({
+    RATE_LIMIT_AUTH_PER_MIN: '100000',
+    RATE_LIMIT_WRITE_PER_MIN: '100000',
+    RATE_LIMIT_READ_PER_MIN: '100000',
+  });
+  agent = request.agent(ctx.app);
+  await agent
+    .post('/api/auth/register')
+    .send({ name: 'Filo', email: 'filo@t.dev', password: 'Password123!' })
+    .expect(201);
+
+  await make({
+    title: 'Calculus problem set',
+    subject: 'Math',
+    type: 'assignment',
+    priority: 'high',
+  });
+  await make({
+    title: 'Linear algebra review',
+    subject: 'Math',
+    type: 'study',
+    priority: 'low',
+    description: 'eigenvalues and 100% of past papers',
+  });
+  await make({
+    title: 'Essay on metaphysics',
+    subject: 'Philosophy',
+    type: 'assignment',
+    priority: 'medium',
+  });
+  await make({
+    title: 'Lab: titration 100% safety',
+    subject: 'Chemistry',
+    type: 'exam',
+    priority: 'high',
+  });
+  const done = await agent
+    .post('/api/tasks')
+    .send({
+      title: 'Calculus problem set (copy)',
+      subject: 'Math',
+      type: 'assignment',
+      status: 'completed',
+    })
+    .expect(201);
+  void done;
+});
+afterAll(() => closeTestApp(ctx));
+
+describe('search & filtering (F9)', () => {
+  it('free-text search across title/description, case-insensitive', async () => {
+    expect(await titles('q=calculus')).toEqual(
+      expect.arrayContaining(['Calculus problem set', 'Calculus problem set (copy)']),
+    );
+    expect(await titles('q=EIGENVALUES')).toContain('Linear algebra review'); // description hit
+    expect(await titles('q=nonexistent-xyz')).toEqual([]);
+  });
+
+  it('escapes LIKE wildcards in user text (no accidental matches)', async () => {
+    // A bare "%" search must match ONLY rows containing a literal percent —
+    // an unescaped LIKE '%' would return every task (5 here).
+    const percents = await titles('q=%25');
+    expect(percents).toEqual(
+      expect.arrayContaining(['Linear algebra review', 'Lab: titration 100% safety']),
+    );
+    expect(percents).toHaveLength(2);
+
+    // "100x" must not match "100% safety" — proves the user % isn't a wildcard.
+    expect(await titles('q=100x')).toEqual([]);
+    // "100" does prefix-match both percent rows (normal substring semantics).
+    expect((await titles('q=100')).length).toBe(2);
+  });
+
+  it('multi-values within one field OR; fields AND together', async () => {
+    const mathOrPhil = await titles('subject=Math&subject=Philosophy');
+    expect(mathOrPhil.length).toBe(4);
+
+    const highAssignments = await titles('priority=high&type=assignment');
+    expect(highAssignments).toEqual(['Calculus problem set']);
+
+    const combo = await titles('q=calculus&status=completed');
+    expect(combo).toEqual(['Calculus problem set (copy)']);
+  });
+
+  it('filters compose with due buckets and filtered totals paginate', async () => {
+    const b = (await agent.get('/api/tasks?q=calculus&limit=1&page=1').expect(200)).body;
+    expect(b.total).toBe(2); // calculus tasks only
+    const page2 = (await agent.get('/api/tasks?q=calculus&limit=1&page=2').expect(200)).body;
+    expect(page2.items).toHaveLength(1);
+    expect(page2.total).toBe(2);
+  });
+
+  it('rejects unknown enum values', async () => {
+    await agent.get('/api/tasks?priority=urgent').expect(400);
+    await agent.get('/api/tasks?status=nope').expect(400);
+  });
+
+  it('caps limit at 100 (pageLimitMax)', async () => {
+    await agent.get('/api/tasks?limit=101').expect(400);
+  });
+});
diff --git a/server/tests/tasks.test.ts b/server/tests/tasks.test.ts
